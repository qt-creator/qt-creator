// This file is generated by "qtcreator -mcp-dump-tools".
// Do not edit. To refresh the snapshot in doc/qtcreator/src/mcp, build
// the regenerate_mcp_tools_doc target and copy its output over it.

//! [tools]
\table
\header
    \li Tool
    \li Description
\row
    \li \c {app_quit}
        \target mcp-app_quit
    \li Quits Qt Creator.
\row
    \li \c {build_add_config}
        \target mcp-build_add_config
    \li Creates a new build configuration for the active project's kit and, unless \c {set_active} is false, makes it active. \c {build_type} is matched against the build types the kit offers (such as "Debug", "Release", \c {RelWithDebInfo}, \c {MinSizeRel}). On a mismatch the error lists the available types. Useful to run or build in a configuration the project does not have yet.
        \list
            \li \c {build_type} (string, required) - Build type to add, such as "Release" (matched case-insensitively against the kit's available build types).
            \li \c {set_active} (boolean) - Make the new configuration active. Defaults to true.
        \endlist
\row
    \li \c {build_cancel}
        \target mcp-build_cancel
    \li Stops the running build, as the Cancel Build button does. Defaults to the most recent build, which fails with reason:\c {not_running} if it has already ended.
        \list
            \li \c {build_id} (integer) - Build to stop. Defaults to the most recent one.
        \endlist
\row
    \li \c {build_get_compile_output}
        \target mcp-build_get_compile_output
    \li Returns the raw Compile Output text of a build - the head and the tail of it, since the first error is the cause and a link or deploy failure has nothing before it. Prefer \l {mcp-build_get_issues}{build_get_issues} for the structured diagnostics. Reach for this when a build or deployment failed without producing any. Defaults to the most recent build. scope:"session" returns the pane's whole text instead, across builds and deployments alike.
        \list
            \li \c {build_id} (integer) - Build to report on. Defaults to the most recent one.
            \li \c {max_chars} (integer) - How much text to return (default 16384, clamped to 1000-204928). A marker naming the dropped character count stands in for what was left out.
            \li \c {scope} (string) - "build" (default): one build's output. "session": everything the pane has shown since Qt Creator started, which ignores \c {build_id}.
        \endlist
\row
    \li \c {build_get_current_config}
        \target mcp-build_get_current_config
    \li Gets the currently active build configuration.
\row
    \li \c {build_get_issues}
        \target mcp-build_get_issues
    \li Errors and warnings of a build, one compiler-style line each ("src/foo.cpp:42: error: ..."), relative to \c {base_dir} where they lie under it. Reports on the most recent build unless \c {build_id} says otherwise, and by default returns the errors, or the warnings when the build produced no errors - so one call covers a build either way. Pass details:true for the compiler's own echo of each issue, and scope:"current" for everything in the Issues pane rather than one build's own - a build system's parse errors, for instance, which no build produced.
        \list
            \li \c {build_id} (integer) - Build to report on. Defaults to the most recent one.
            \li \c {details} (boolean) - Append each issue's detail lines - the offending source and the notes under it, which \l {mcp-build_get_compile_output}{build_get_compile_output} carries as well. Off by default. Turn it on for a diagnostic whose summary alone does not say enough.
            \li \c {file} (string) - Absolute path of a single file to report on.
            \li \c {max} (integer) - How many lines to return (default 50, clamped to 1-1000). The first error is usually the cause and the rest cascade.
            \li \c {offset} (integer) - How many matching issues to skip, for reading past a truncated reply.
            \li \c {scope} (string) - "build" (default): what the build named by \c {build_id} produced. "current": everything the Issues pane holds now, which ignores \c {build_id}.
            \li \c {severity} (string) - Which issues to return. "auto" (default) is the errors, or the warnings when there are no errors. \c {error_count} and \c {warning_count} are reported whichever you pick, and the reply says which severity it settled on.
        \endlist
\row
    \li \c {build_get_status}
        \target mcp-build_get_status
    \li Reports a build's state, waiting for it to finish first: a running build blocks this call for up to \c {wait_ms}, a finished one answers at once. Defaults to the most recent build, whether \l {mcp-build_project}{build_project} or the user started it. state:"running" means the wait budget ran out, not that anything went wrong - call again to keep waiting, and repeat until state is something else. Never sleep between calls. The waiting happens here. Counts only. Read the diagnostics with \l {mcp-build_get_issues}{build_get_issues} and the raw text with \l {mcp-build_get_compile_output}{build_get_compile_output}.
        \list
            \li \c {build_id} (integer) - Build to report on. Defaults to the most recent one.
            \li \c {wait_ms} (integer) - How long to wait for a running build before answering state:"running" (default 45000). Clamped to 0-55000: a longer wait outlives the request timeout of typical clients, which drops the session and cancels the build. Pass 0 for an immediate snapshot.
        \endlist
\row
    \li \c {build_list_configs}
        \target mcp-build_list_configs
    \li Lists available build configurations.
\row
    \li \c {build_project}
        \target mcp-build_project
    \li Starts a build of the named project - the startup project when no name is given - and returns at once with a \c {build_id}. The build runs in the background. This call never waits for it. Wait for the verdict with \l {mcp-build_get_status}{build_get_status}, then read the diagnostics with \l {mcp-build_get_issues}{build_get_issues} and the raw text with \l {mcp-build_get_compile_output}{build_get_compile_output}. None of them are carried here, so a build that succeeds costs one small reply. One build runs at a time. When one is already going this starts nothing and answers reason:\c {build_in_progress} with that build's \c {build_id}: wait on that ID, then call again.
        \list
            \li \c {project_name} (string) - Project to build. Pass \c {project_path} as well when several loaded projects share the name.
            \li \c {project_path} (string) - Absolute path to the project file (\c {CMakeLists.txt}, .pro, ...). Identifies the project when display names collide.
        \endlist
\row
    \li \c {build_switch_config}
        \target mcp-build_switch_config
    \li Switches to a specific build configuration.
        \list
            \li \c {name} (string, required) - Name of the build configuration to switch to.
        \endlist
\row
    \li \c {cmake_reconfigure}
        \target mcp-cmake_reconfigure
    \li Re-runs CMake on a project (equivalent to Build > Run CMake) and blocks until CMake finishes. Returns a verdict: {succeeded, \c {error_count}, \c {warning_count}, \c {duration_ms}, issues, \c {summary_text}}. Use after editing \c {CMakeLists.txt} to add a target or test so the next \l {mcp-build_project}{build_project}/\l {mcp-test_run}{test_run} sees the refreshed target list. The natural pattern is \l {mcp-cmake_reconfigure}{cmake_reconfigure} -> \l {mcp-build_project}{build_project} -> \l {mcp-test_run}{test_run}. Uses the startup project if \c {project} is omitted.
        \list
            \li \c {mode} (string) - \c {normal} (default): standard reconfigure. \c {profiling}: reconfigure with profiling enabled and open the CTF Visualizer with the resulting profile.
            \li \c {project} (string) - Name of the project to reconfigure. Uses the startup project if omitted. Run \l {mcp-project_list}{project_list} to see available names.
        \endlist
\row
    \li \c {cmake_reset_configuration}
        \target mcp-cmake_reset_configuration
    \li Discards the CMake configuration of the project's active build configuration (equivalent to Build > Clear CMake Configuration) and, unless reconfigure is false, configures it again from scratch, blocking until CMake finishes. Deletes \c {CMakeCache.txt}, \c {CMakeFiles} and the file-api reply directory in that build directory, so cache values set outside the configuration's initial CMake arguments are lost. Use this when a build directory is stale or broken - after a failed first configure, a plain \l {mcp-cmake_reconfigure}{cmake_reconfigure} keeps re-running CMake without the initial arguments and cannot recover on its own. Switch configurations with \l {mcp-build_switch_config}{build_switch_config} to reset another one. Returns the same verdict as \l {mcp-cmake_reconfigure}{cmake_reconfigure}.
        \list
            \li \c {project} (string) - Name of the project to reset. Uses the startup project if omitted. Run \l {mcp-project_list}{project_list} to see available names.
            \li \c {reconfigure} (boolean) - Run CMake again after clearing the configuration. Defaults to true. Pass false to leave the project unconfigured.
        \endlist
\row
    \li \c {cpp_find_callees}
        \target mcp-cpp_find_callees
    \li Finds the functions called by the C++ function at a position - the outgoing call hierarchy - using the C++ code model. Give the file and a 1-based line and column pointing at a function name. Returns each called function grouped with its call sites (file, 1-based line and column, and source line text). It resolves the function's definition, so the body must be available. The file must belong to an open project.
        \list
            \li \c {column} (integer, required) - 1-based column of the function name to resolve.
            \li \c {file} (string, required) - Absolute path to the C++ file containing the function.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
            \li \c {line} (integer, required) - 1-based line of the function name to resolve.
        \endlist
\row
    \li \c {cpp_find_callers}
        \target mcp-cpp_find_callers
    \li Finds the callers of the C++ function at a position - the incoming call hierarchy - using the C++ code model. Give the file and a 1-based line and column pointing at a function name. Returns each call site with its file, 1-based line and column, the source line text, and the enclosing function (with its own location) that makes the call. The file must belong to an open project.
        \list
            \li \c {column} (integer, required) - 1-based column of the function name to resolve.
            \li \c {file} (string, required) - Absolute path to the C++ file containing the function.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
            \li \c {line} (integer, required) - 1-based line of the function name to resolve.
        \endlist
\row
    \li \c {cpp_find_overrides}
        \target mcp-cpp_find_overrides
    \li Finds the overriding implementations of the virtual C++ member function at a position - go to implementation(s) - across the class hierarchy, plus the base declaration(s) it overrides. Give the file and a 1-based line and column on a function name. Returns "overrides" (each with its fully qualified name, signature and location), \c {base_declarations}, and whether the function is virtual. The file must belong to an open project.
        \list
            \li \c {column} (integer, required) - 1-based column of the function name.
            \li \c {file} (string, required) - Absolute path to the C++ file containing the function.
            \li \c {line} (integer, required) - 1-based line of the function name.
        \endlist
\row
    \li \c {cpp_find_references}
        \target mcp-cpp_find_references
    \li Finds all references (usages) of the C++ symbol at a position, using the C++ code model. Give the file and a 1-based line and column pointing at an identifier. Returns each usage with its file, 1-based line and column, the source line text, the containing function, and whether it is a read, write or declaration. The file must belong to an open project.
        \list
            \li \c {column} (integer, required) - 1-based column of the identifier to resolve.
            \li \c {file} (string, required) - Absolute path to the C++ file containing the symbol.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
            \li \c {line} (integer, required) - 1-based line of the identifier to resolve.
        \endlist
\row
    \li \c {cpp_find_signal_connections}
        \target mcp-cpp_find_signal_connections
    \li Finds the signal/slot connections involving the C++ function at a position, by scanning the connect() and disconnect() calls the code model can see. Give the file and a 1-based line and column on a signal, slot or other member function. Ask with a signal to learn which slots it is connected to, with a slot to learn which signals trigger it. Each connection reports its location, whether it is a connect or disconnect, the "role" the function plays in it (signal or slot), the sender, signal, receiver and slot arguments as written, how the slot is given (\c {slot_kind}: \c {qt4_macro} for SIGNAL()/SLOT(), \c {member_pointer} for &\c {Class::member}, lambda, or another expression), an optional \c {connection_type}, and the position of the "counterpart" argument, ready for \l {mcp-cpp_get_symbol_info}{cpp_get_symbol_info}. Limits: only textual connect/disconnect calls in files the code model has parsed are seen - not connections made in .ui files, by \c {connectSlotsByName}, from QML, or through wrapper functions. A SIGNAL()/SLOT() macro the code model cannot resolve is matched by name alone and reported with "resolved" false.
        \list
            \li \c {column} (integer, required) - 1-based column of the function name.
            \li \c {file} (string, required) - Absolute path to the C++ file containing the function.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
            \li \c {line} (integer, required) - 1-based line of the function name.
        \endlist
\row
    \li \c {cpp_find_symbols}
        \target mcp-cpp_find_symbols
    \li Searches the project-wide C++ code model index by name - a fast "go to symbol". The index holds classes, enums, function definitions, signals and type aliases. It does not contain plain declarations (data members, globals, or member functions that are only declared), so an empty result does not prove a name is unused - use \l {mcp-cpp_get_file_symbols}{cpp_get_file_symbols} for the complete symbol list of a known file. Give a case-insensitive name substring. Optionally restrict by "kind" and cap the count with "limit". Results are ranked (exact, then prefix, then substring) so the most relevant survive the cap. \c {total_matches} and "truncated" report when the cap dropped matches. Each match has its name, kind, fully qualified scope, type/signature, and file with 1-based line and column.
        \list
            \li \c {kind} (string) - Optional: restrict to one kind. "function" is function definitions. "declaration" is type aliases and signals (the index holds no plain declarations).
            \li \c {limit} (integer) - Optional: maximum number of results (default 200).
            \li \c {query} (string, required) - Case-insensitive substring to match against symbol names (matched against the fully qualified name).
        \endlist
\row
    \li \c {cpp_get_file_problems}
        \target mcp-cpp_get_file_problems
    \li Returns the C++ code model diagnostics (parser and semantic warnings and errors) for a file, each with its severity and 1-based line and column. The file must be known to the code model, that is, a C++ source or header that belongs to an open project.
        \list
            \li \c {file} (string, required) - Absolute path to the C++ source or header file.
        \endlist
\row
    \li \c {cpp_get_file_symbols}
        \target mcp-cpp_get_file_symbols
    \li Returns the C++ symbols (classes, functions, enums, declarations) in a file from Qt Creator's C++ code model, each with its kind, fully qualified scope, type/signature and 1-based line and column. The file must be known to the code model, that is, a C++ source or header that belongs to an open project.
        \list
            \li \c {file} (string, required) - Absolute path to the C++ source or header file.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
        \endlist
\row
    \li \c {cpp_get_include_hierarchy}
        \target mcp-cpp_get_include_hierarchy
    \li Returns the include hierarchy of a C++ file from the code model: the files it includes directly (each with the 1-based line of the #include, the name as written, and whether it was a <global> or a "local" include), the files that include it directly (each with the line of their #include), and the #includes that could not be resolved to a file. Set "transitive" to also get the flattened closures: every file it pulls in, and every file that depends on it. The file must be known to the code model, that is, a C++ source or header that belongs to an open project or is included by one.
        \list
            \li \c {file} (string, required) - Absolute path to the C++ source or header file.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
            \li \c {transitive} (boolean) - Also return \c {transitive_includes} and \c {transitive_included_by}. Default false.
        \endlist
\row
    \li \c {cpp_get_quick_fixes}
        \target mcp-cpp_get_quick_fixes
    \li Lists the C++ quick-fixes and refactoring actions the editor offers at a position - what "Alt+Enter" would show - each with its description. Give the file and a 1-based line and column. This only lists the available actions. It does not apply them. The file is opened in an editor if it is not already, and must belong to an open project and be parsed (the actions depend on the editor's semantic info being up to date).
        \list
            \li \c {column} (integer, required) - 1-based column of the position.
            \li \c {file} (string, required) - Absolute path to the C++ file.
            \li \c {line} (integer, required) - 1-based line of the position.
        \endlist
\row
    \li \c {cpp_get_symbol_info}
        \target mcp-cpp_get_symbol_info
    \li Resolves the C++ symbol at a position and returns its name, fully qualified name, kind and type, plus its declaration and (for functions) definition locations - that is, go-to-definition. Give the file and a 1-based line and column pointing at an identifier. The file must belong to an open project.
        \list
            \li \c {column} (integer, required) - 1-based column of the identifier.
            \li \c {file} (string, required) - Absolute path to the C++ file.
            \li \c {line} (integer, required) - 1-based line of the identifier.
        \endlist
\row
    \li \c {cpp_get_type_hierarchy}
        \target mcp-cpp_get_type_hierarchy
    \li Returns the base and derived class hierarchy of the C++ class or struct at a position. Give the file and a 1-based line and column pointing at a class name. Returns the class with nested "bases" (up) and "derived" (down), each with name and location. The file must belong to an open project.
        \list
            \li \c {column} (integer, required) - 1-based column of the class name.
            \li \c {file} (string, required) - Absolute path to the C++ file.
            \li \c {line} (integer, required) - 1-based line of the class name.
        \endlist
\row
    \li \c {cpp_rename_symbol}
        \target mcp-cpp_rename_symbol
    \li Renames the C++ symbol at a position across the whole project, using the code model - the rename refactoring. Give the file and a 1-based line and column on an identifier, and the \c {new_name}. By default this is a DRY RUN: it returns the edits it would make (each with file, 1-based line and column, length, and the old and new text) and changes nothing. Set "apply" to true to write the edits. Only files belonging to the open projects are edited, never Qt or system headers. \c {skipped_edits} and \c {skipped_files} report the usages left untouched by that filter, so a partial rename is visible rather than silent. Before anything is written the new name is checked for clashes: a declaration of that name in the same scope, a base-class member it would hide or start to override, an outer declaration it would shadow, or a declaration that would capture one of the renamed usages and make it mean something else. "conflicts" lists them with a severity. "apply" is refused while a hard conflict exists unless "force" is true. \c {other_declarations_with_name} lists unrelated indexed symbols that already have the new name, for information.
        \list
            \li \c {apply} (boolean) - Write the edits to disk. Default false (dry run).
            \li \c {column} (integer, required) - 1-based column of the identifier to rename.
            \li \c {file} (string, required) - Absolute path to the C++ file containing the symbol.
            \li \c {force} (boolean) - Apply even though the new name has a hard conflict. Default false.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
            \li \c {line} (integer, required) - 1-based line of the identifier to rename.
            \li \c {new_name} (string, required) - The new identifier name.
        \endlist
\row
    \li \c {debugger_add_breakpoint}
        \target mcp-debugger_add_breakpoint
    \li Adds a new breakpoint in Qt Creator's debugger.
        \list
            \li \c {address} (integer) - Memory address (for address or \c {watchAddress} type).
            \li \c {condition} (string) - Optional condition expression.
            \li \c {enabled} (boolean) - Whether the breakpoint is enabled. Defaults to true.
            \li \c {file} (string) - Absolute path to the source file (for \c {fileAndLine} type).
            \li \c {function} (string) - Function name (for function type).
            \li \c {ignore_count} (integer) - Number of hits to ignore before breaking.
            \li \c {line} (integer) - Line number in the source file (for \c {fileAndLine} type).
            \li \c {one_shot} (boolean) - If true, the breakpoint is removed after the first hit.
            \li \c {type} (string) - Breakpoint type. Defaults to \c {fileAndLine}.
        \endlist
\row
    \li \c {debugger_add_watch_expression}
        \target mcp-debugger_add_watch_expression
    \li Adds an expression to the watch list in the current debug session. The expression is evaluated and its value updated as execution progresses. Returns the iname of the new watch entry (such as "watch.0"), which can be used with \l {mcp-debugger_get_variable}{debugger_get_variable}, \l {mcp-debugger_set_variable}{debugger_set_variable}, and \l {mcp-debugger_remove_watch_expression}{debugger_remove_watch_expression}. Returns an error if no debug session is active or the debugger is not paused.
        \list
            \li \c {expression} (string, required) - Expression to watch (such as \c {myVar}, "ptr->field").
            \li \c {name} (string) - Optional display name. Defaults to the expression.
        \endlist
\row
    \li \c {debugger_collapse_all_children}
        \target mcp-debugger_collapse_all_children
    \li Recursively clears the expanded state of every descendant of the given variable, so re-expanding it shows its whole subtree collapsed at all levels. Returns an error if no debug session is active or the debugger is not paused.
        \list
            \li \c {iname} (string, required) - Internal name of the variable (such as "local.\c {myVar}").
        \endlist
\row
    \li \c {debugger_continue}
        \target mcp-debugger_continue
    \li Resumes program execution in the debugger until the next breakpoint. Pass \c {wait_for_completion} to wait until the target stops again. Requires an active debug session that is paused.
        \list
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 10000, at most 120000).
            \li \c {wait_for_completion} (boolean) - Wait until the operation has completed and the data it changes (call stack, local variables) has been refreshed, instead of returning once the request was accepted. Default false.
        \endlist
\row
    \li \c {debugger_delete_breakpoint}
        \target mcp-debugger_delete_breakpoint
    \li Deletes a breakpoint by its ID (as returned by \l {mcp-debugger_get_breakpoints}{debugger_get_breakpoints} or \l {mcp-debugger_add_breakpoint}{debugger_add_breakpoint}).
        \list
            \li \c {id} (integer, required) - ID of the breakpoint to delete.
        \endlist
\row
    \li \c {debugger_evaluate_expression}
        \target mcp-debugger_evaluate_expression
    \li Evaluates an expression in the selected frame of the current debug session. Returns the expression's value and type once the debugger has evaluated it for the current stop, or an error if that does not happen in time. Requires an active debug session that is paused.
        \list
            \li \c {expression} (string, required) - Expression to evaluate (such as \c {myVar}, "ptr->field", "a + b").
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 5000, at most 120000).
        \endlist
\row
    \li \c {debugger_get_breakpoints}
        \target mcp-debugger_get_breakpoints
    \li Returns all breakpoints currently set in Qt Creator's debugger.
\row
    \li \c {debugger_get_call_stack}
        \target mcp-debugger_get_call_stack
    \li Returns the call stack (stack frames) of the selected thread. Waits until the stack of the current stop and thread has arrived, and reports an error instead of an older stack if it does not arrive in time. Returns an error if no debug session is active or the debugger is not paused.
        \list
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 5000, at most 120000).
        \endlist
\row
    \li \c {debugger_get_capabilities}
        \target mcp-debugger_get_capabilities
    \li Reports the debug session's environment (debugger, target architecture and OS, connection and session type; "unknown" where Qt Creator does not know) and, for each kind of operation, whether its tools are offered, whether the session's debugger supports it, whether the session is in a state for it, and whether it is permitted. Call this before choosing how to investigate.
\row
    \li \c {debugger_get_expanded_inames}
        \target mcp-debugger_get_expanded_inames
    \li Returns the sorted set of inames currently marked as expanded in the Locals and Expressions view. Returns an error if no debug session is active or the debugger is not paused.
\row
    \li \c {debugger_get_registers}
        \target mcp-debugger_get_registers
    \li Returns the CPU registers of the selected thread and frame of the paused debug session, read freshly from the debugger. Read-only. Values are given in hex with all bits; a register without a value is reported as not available rather than as zero. For a frame other than the innermost, \c {values_for_frame_level} says whether the debugger reconstructed the values for that frame or reports the innermost frame's. Returns an error if the debugger cannot access registers, if no session is active or if it is not paused.
        \list
            \li \c {group} (string) - Only registers in this group, as listed in "groups" of an earlier answer.
            \li \c {names} (array) - Registers to return, such as ["pc", "sp"]. Default: all.
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 5000, at most 120000).
        \endlist
\row
    \li \c {debugger_get_status}
        \target mcp-debugger_get_status
    \li Returns the current status of the debugger including whether a session is active, its state (paused/running/stopped), and the current position if paused.
        \list
            \li \c {include_log} (boolean) - Also return the raw debugger log (the commands exchanged with the backend, such as GDB/MI) in a "log" field. Default false.
        \endlist
\row
    \li \c {debugger_get_thread_stacks}
        \target mcp-debugger_get_thread_stacks
    \li Collects the call stacks of all threads, or of the given threads, of the paused debug session, for example to look for a deadlock. Selects each thread in turn and selects the original thread and frame again at the end. Does not resume the target. Reports per thread when a stack could not be collected, and reports when the target resumed during collection instead of mixing stacks from different stops. Covers the threads the debugger reports, which is not necessarily every CPU, process or RTOS task of the device.
        \list
            \li \c {fields} (array) - Frame fields to return besides level. Default: all.
            \li \c {max_frames} (integer) - Frames per thread, innermost first.
            \li \c {max_threads} (integer) - Threads to collect at most. The rest is listed in \c {omitted_threads}.
            \li \c {max_total_frames} (integer) - Frames over all threads at most.
            \li \c {thread_ids} (array) - Threads to collect, as returned by \l {mcp-debugger_get_threads}{debugger_get_threads}. Default: all.
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 5000, at most 120000).
        \endlist
\row
    \li \c {debugger_get_threads}
        \target mcp-debugger_get_threads
    \li Returns all threads of the current debug session. Returns an error if no debug session is active or the debugger is not paused.
\row
    \li \c {debugger_get_variable}
        \target mcp-debugger_get_variable
    \li Returns the details of a single variable by its iname, including its children if it has any (such as struct members or array elements). If a child also has \c {has_children}=true, call \l {mcp-debugger_get_variable}{debugger_get_variable} again with that child's iname to retrieve its sub-fields. Waits until the variables of the current stop have arrived. Returns an error if no debug session is active or the debugger is not paused.
        \list
            \li \c {iname} (string, required) - Internal name of the variable (such as "local.\c {myVar}").
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 5000, at most 120000).
        \endlist
\row
    \li \c {debugger_get_variables}
        \target mcp-debugger_get_variables
    \li Returns local variables for the current stack frame. Optionally includes watch expressions. Variables with \c {has_children}=true may include a children array if already expanded. Otherwise call \l {mcp-debugger_get_variable}{debugger_get_variable} with the variable's iname to retrieve sub-fields. Waits until the variables of the current stop, thread and frame have arrived, and reports an error instead of older values if they do not arrive in time. Returns an error if no debug session is active or the debugger is not paused.
        \list
            \li \c {include_watchers} (boolean) - Also return watch expressions (default: false).
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 5000, at most 120000).
        \endlist
\row
    \li \c {debugger_interrupt}
        \target mcp-debugger_interrupt
    \li Pauses the currently running debuggee. Pass \c {wait_for_completion} to wait until the target has stopped and its call stack and local variables have been refreshed. Requires an active debug session that is running.
        \list
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 10000, at most 120000).
            \li \c {wait_for_completion} (boolean) - Wait until the operation has completed and the data it changes (call stack, local variables) has been refreshed, instead of returning once the request was accepted. Default false.
        \endlist
\row
    \li \c {debugger_print_console_message}
        \target mcp-debugger_print_console_message
    \li Appends a message of the given type to the QML Debugger Console, exactly as the debugger would. Useful for exercising the console's auto-popup behavior. Does not require an active debug session.
        \list
            \li \c {text} (string) - Message text.
            \li \c {type} (string, required) - Message type: error, warning, debug, or default.
        \endlist
\row
    \li \c {debugger_read_memory}
        \target mcp-debugger_read_memory
    \li Reads bytes of target memory from an address in the paused debug session. Read-only. Returns the range as segments, each either readable with its bytes or not readable with a reason; unreadable bytes are never returned as zeros. Reads at most the number of bytes configured in Preferences > Debugger > General > MCP Server and says so when it read less than asked. On bare metal targets and targets of unknown kind, where an address may be memory-mapped I/O, only ranges allowed there can be read.
        \list
            \li \c {address} (required) - Start address, such as "0x16fdff2a0" or a decimal number.
            \li \c {encoding} (string)
            \li \c {length} (integer, required) - Number of bytes to read.
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 10000, at most 120000).
        \endlist
\row
    \li \c {debugger_remove_watch_expression}
        \target mcp-debugger_remove_watch_expression
    \li Removes a watch expression from the current debug session by its iname. Returns an error if the iname is not found or is not a watch expression, or if no debug session is active or the debugger is not paused.
        \list
            \li \c {iname} (string, required) - Internal name of the watch entry to remove (such as "watch.0").
        \endlist
\row
    \li \c {debugger_run_to_line}
        \target mcp-debugger_run_to_line
    \li Resumes execution until it reaches the given 1-based line in the given file, then stops (like the debugger's "Run to Line"). Pass \c {wait_for_completion} to wait until the target has stopped. Requires an active debug session that is paused and an engine that supports running to a line.
        \list
            \li \c {file} (string, required) - Absolute path of the source file.
            \li \c {line} (integer, required) - 1-based line to run to.
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 10000, at most 120000).
            \li \c {wait_for_completion} (boolean) - Wait until the operation has completed and the data it changes (call stack, local variables) has been refreshed, instead of returning once the request was accepted. Default false.
        \endlist
\row
    \li \c {debugger_select_frame}
        \target mcp-debugger_select_frame
    \li Switches the current stack frame in the active debug session. Subsequent \l {mcp-debugger_get_variables}{debugger_get_variables} / \l {mcp-debugger_evaluate_expression}{debugger_evaluate_expression} calls operate on the selected frame. The variables of the frame arrive asynchronously: pass \c {wait_for_completion} to wait for them, or use \l {mcp-debugger_wait_for_operation}{debugger_wait_for_operation}. Returns an error if no debug session is active or the debugger is not paused.
        \list
            \li \c {level} (integer, required) - Frame level to select (as returned by \l {mcp-debugger_get_call_stack}{debugger_get_call_stack}, 0 = innermost).
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 10000, at most 120000).
            \li \c {wait_for_completion} (boolean) - Wait until the operation has completed and the data it changes (call stack, local variables) has been refreshed, instead of returning once the request was accepted. Default false.
        \endlist
\row
    \li \c {debugger_select_thread}
        \target mcp-debugger_select_thread
    \li Switches the current thread in the active debug session. The call stack and variables of the new thread arrive asynchronously: pass \c {wait_for_completion} to wait for them, or use \l {mcp-debugger_wait_for_operation}{debugger_wait_for_operation}. Returns an error if no debug session is active or the debugger is not paused.
        \list
            \li \c {id} (string, required) - Thread ID to select (as returned by \l {mcp-debugger_get_threads}{debugger_get_threads}).
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 10000, at most 120000).
            \li \c {wait_for_completion} (boolean) - Wait until the operation has completed and the data it changes (call stack, local variables) has been refreshed, instead of returning once the request was accepted. Default false.
        \endlist
\row
    \li \c {debugger_set_display_format}
        \target mcp-debugger_set_display_format
    \li Sets the display format of a single variable (by iname) in the current debug session, as the Locals view context menu does. Use 0 to reset to Automatic. Common format codes: 0=Automatic, 5=Latin1String, 7=Utf8String, 12=Array of 10, 22=Decimal, 23=Hexadecimal, 24=Binary, 25=Octal. The format is remembered for the variable's current type only. Returns an error if no debug session is active or the debugger is not paused.
        \list
            \li \c {format} (integer, required) - Display format code (0 = Automatic).
            \li \c {iname} (string, required) - Internal name of the variable (such as "local.\c {myVar}").
        \endlist
\row
    \li \c {debugger_set_variable}
        \target mcp-debugger_set_variable
    \li Changes the value of a variable in the current debug session. Only works for variables where \c {value_editable} is true. Returns an error if no debug session is active or the debugger is not paused.
        \list
            \li \c {iname} (string, required) - Internal name of the variable (such as "local.\c {myVar}").
            \li \c {value} (string, required) - New value to assign.
        \endlist
\row
    \li \c {debugger_start}
        \target mcp-debugger_start
    \li Starts a debug session and returns once the launch has been requested. Poll \l {mcp-debugger_get_status}{debugger_get_status} for the session state. With no arguments, debugs the current startup project using its active run configuration and kit (does not build first - use the \l {mcp-build_project}{build_project} tool beforehand if it may be out of date). If "executable" is given, debugs that executable directly (no project or build needed) with an optional kit, arguments, working directory and QML debugging. If \c {remote_channel} is also given, attaches to an already-running gdbserver or stub at that channel (for example, a bare-metal target) instead of launching the executable locally. The executable then only supplies symbols.
        \list
            \li \c {arguments} (array) - Command-line arguments for the executable.
            \li \c {break_at_main} (boolean) - Set a temporary breakpoint at main and stop there. Without "executable" it applies to the next debug start, which a pending build may delay. When attaching to a remote server it is honored by GDB and CDB kits only.
            \li \c {executable} (string) - Absolute path to an executable to debug directly. If omitted, the startup project is used.
            \li \c {extended_remote} (boolean) - Use "target extended-remote" for \c {remote_channel} (a "gdbserver --multi" server): the program is launched with run, so "arguments" are passed to it, instead of continuing an already-started process.
            \li \c {kit} (string) - Kit ID to use (defaults to the default kit). Only used with "executable".
            \li \c {native_mixed} (boolean) - Debug C++ and QML in one native combined session instead of starting a separate QML engine. Needs \c {qml_debugging} as well. The QTC_DEBUGGER_NATIVE_MIXED environment variable overrides this.
            \li \c {qml_debugging} (boolean) - Enable QML debugging. Cannot be combined with \c {remote_channel}.
            \li \c {remote_channel} (string) - Attach to an already-running gdbserver/stub at this channel (such as "localhost:1234" or "tcp:localhost:1234", CDB kits need the cdb form, such as "tcp:server=localhost,port=1234") instead of launching the executable. Requires "executable" for symbols.
            \li \c {working_directory} (string) - Working directory (defaults to the executable's directory).
        \endlist
\row
    \li \c {debugger_step_in}
        \target mcp-debugger_step_in
    \li Steps into the next function call in the debugger. Pass \c {wait_for_completion} to wait until the target has stopped and its call stack and local variables have been refreshed. Requires an active debug session that is paused.
        \list
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 10000, at most 120000).
            \li \c {wait_for_completion} (boolean) - Wait until the operation has completed and the data it changes (call stack, local variables) has been refreshed, instead of returning once the request was accepted. Default false.
        \endlist
\row
    \li \c {debugger_step_out}
        \target mcp-debugger_step_out
    \li Steps out of the current function in the debugger. Pass \c {wait_for_completion} to wait until the target has stopped and its call stack and local variables have been refreshed. Requires an active debug session that is paused.
        \list
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 10000, at most 120000).
            \li \c {wait_for_completion} (boolean) - Wait until the operation has completed and the data it changes (call stack, local variables) has been refreshed, instead of returning once the request was accepted. Default false.
        \endlist
\row
    \li \c {debugger_step_over}
        \target mcp-debugger_step_over
    \li Steps over the current line in the debugger. Pass \c {wait_for_completion} to wait until the target has stopped and its call stack and local variables have been refreshed. Requires an active debug session that is paused.
        \list
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 10000, at most 120000).
            \li \c {wait_for_completion} (boolean) - Wait until the operation has completed and the data it changes (call stack, local variables) has been refreshed, instead of returning once the request was accepted. Default false.
        \endlist
\row
    \li \c {debugger_stop}
        \target mcp-debugger_stop
    \li Stops the current debug session. Returns a message indicating whether the stop was successful.
\row
    \li \c {debugger_wait_for_operation}
        \target mcp-debugger_wait_for_operation
    \li Reports the status of an operation started by a stepping, continue, interrupt, run-to-line, thread selection or frame selection tool, waiting up to \c {timeout_ms} for it to complete. With \c {timeout_ms} 0, reports the status without waiting. A status of \c {timed_out} means the wait ended first: the operation is not cancelled.
        \list
            \li \c {operation_id} (integer, required) - The \c {operation_id} an operation tool returned.
            \li \c {timeout_ms} (integer) - How long to wait, in milliseconds, before reporting that the result is not ready (default 10000, at most 120000).
        \endlist
\row
    \li \c {device_add}
        \target mcp-device_add
    \li Creates a new device of the given device-type ID (such as \c {GenericLinuxOsType}) and adds it to the \c {DeviceManager}, without going through the GUI wizard. \c {params} sets the SSH parameters (\c {host}, \c {port}, \c {userName}, \c {privateKeyFile}, \c {useKeyFile}, \c {timeout}, \c {hostKeyCheckingMode}). Returns the new device ID.
        \list
            \li \c {displayName} (string) - Display name for the new device (optional).
            \li \c {params} (object) - SSH parameters: host, port, \c {userName}, \c {privateKeyFile}, \c {useKeyFile}, timeout, \c {hostKeyCheckingMode} (none|strict|\c {allowNoMatch}).
            \li \c {type} (string, required) - Device-type ID, such as \c {GenericLinuxOsType}. See the \c {type} field of \l {mcp-device_list}{device_list}, or use \l {mcp-device_list_types}{device_list_types}.
        \endlist
\row
    \li \c {device_detect_tools}
        \target mcp-device_detect_tools
    \li Connects to the device and runs the same auto-detection as the device configuration's "Run Auto-Detection Now" button: detects toolchains and debuggers on the device, detects on-device build tools (rsync, cmake, ...), and then creates kits for the device. Use this to set up a remote build/run/debug environment without the GUI. Returns the kits now associated with the device.
        \list
            \li \c {id} (string, required) - Device ID.
        \endlist
\row
    \li \c {device_list}
        \target mcp-device_list
    \li Lists all devices known to Qt Creator (\c {ProjectExplorer::DeviceManager}), with their ID, type, display name, connection state, and SSH parameters.
\row
    \li \c {device_list_types}
        \target mcp-device_list_types
    \li Lists the device-type IDs that can be passed to \l {mcp-device_add}{device_add}, with their display names and whether they can be created programmatically.
\row
    \li \c {device_remove}
        \target mcp-device_remove
    \li Removes the device with the given ID from the \c {DeviceManager}. As in the Devices preferences page, an auto-detected device can only be removed while it is disconnected. The local desktop device can never be removed. Kits referring to the device are left behind, so remove those with \l {mcp-kit_remove}{kit_remove}.
        \list
            \li \c {id} (string, required) - Device ID.
        \endlist
\row
    \li \c {device_set_parameters}
        \target mcp-device_set_parameters
    \li Updates the display name and/or SSH parameters of an existing device. Only the fields present in \c {params} are changed. Others keep their current values.
        \list
            \li \c {displayName} (string) - New display name (optional).
            \li \c {id} (string, required) - Device ID.
            \li \c {params} (object) - SSH parameters to change: host, port, \c {userName}, \c {privateKeyFile}, \c {useKeyFile}, timeout, \c {hostKeyCheckingMode}.
        \endlist
\row
    \li \c {device_test}
        \target mcp-device_test
    \li Runs the device's connection tester (\c {IDevice::createDeviceTester}()), collecting the streamed progress and error messages, and returns the final result. Blocks until the test finishes or the timeout elapses.
        \list
            \li \c {id} (string, required) - Device ID.
            \li \c {timeoutSeconds} (integer) - Abort the test after this many seconds (default 60).
        \endlist
\row
    \li \c {editor_close}
        \target mcp-editor_close
    \li Closes a file in Qt Creator.
        \list
            \li \c {path} (string, required) - Absolute path of the file to close.
        \endlist
\row
    \li \c {editor_create_file}
        \target mcp-editor_create_file
    \li Creates a new file at the specified path and optionally populates it with text. Creates parent directories automatically. Fails if the file already exists.
        \list
            \li \c {path} (string, required) - Absolute path where the file should be created.
            \li \c {text} (string) - Optional content to write into the new file.
        \endlist
\row
    \li \c {editor_get_completions}
        \target mcp-editor_get_completions
    \li Returns the code-completion proposals at a position in a file, as the editor would offer them, from the engine that editor uses there - the language server when one serves the file, otherwise the editor's own model - so it works for any kind of file that completes in the editor: C++, QML, CMake, Python and so on. Useful before writing code. Give the file and a 1-based line and column (the cursor point, for example, just after a . or "::"). Returns the candidate completions, each with its text and any detail (signature/type), filtered and ranked by the prefix already typed. The file is opened in an editor if it is not already. An engine still loading the file proposes what it knows so far, as it would to a user.
        \list
            \li \c {column} (integer, required) - 1-based column of the cursor position.
            \li \c {file} (string, required) - Absolute path to the file.
            \li \c {limit} (integer) - Maximum number of completions to return (default 200, at most 1000).
            \li \c {line} (integer, required) - 1-based line of the cursor position.
        \endlist
\row
    \li \c {editor_get_cursor_position}
        \target mcp-editor_get_cursor_position
    \li Returns where the text cursor sits in the editor the user is working in: the "path" of that editor, the 1-based "line" and "column", and the \c {line_text} of the line it is on, cut to 400 characters with \c {line_text_truncated} set when the line is longer. When the cursor has a selection, \c {has_selection} is true and it spans \c {selection_start_line}/\c {selection_start_column} to \c {selection_end_line}/\c {selection_end_column}, which \l {mcp-editor_select_text}{editor_select_text} turns back into the selected text. \c {cursor_count} is above 1 when the editor holds several cursors, in which case the position reported is the main one. This is how to resolve a request phrased as "the current line" or "the method the cursor is in": the coordinates are the 1-based line and column that \l {mcp-editor_open}{editor_open}, \l {mcp-editor_select_text}{editor_select_text} and the cpp_* and lsp_* tools take, so \l {mcp-cpp_get_symbol_info}{cpp_get_symbol_info} resolves the symbol under the cursor and \l {mcp-cpp_get_file_symbols}{cpp_get_file_symbols} the one it sits inside. This is the text cursor: the mouse pointer is \l {mcp-ui_get_pointer_position}{ui_get_pointer_position}, and \l {mcp-editor_move_cursor}{editor_move_cursor} moves that pointer rather than the caret. Read-only.
\row
    \li \c {editor_get_folds}
        \target mcp-editor_get_folds
    \li Returns the code-folding structure of the current text editor, one entry per line: the 1-based "line", the \c {fold_indent} (nesting level behind the fold markers - a line starts a foldable region when the next line has a greater indent, and the region extends until the indent drops back), whether the line is currently "folded", whether it is \c {ifdefed_out} (inactive/greyed preprocessor code), and a trimmed "text" snippet. Use it to check which lines are foldable, how far each fold region reaches, and how folding interacts with inactive code. Read-only.
\row
    \li \c {editor_get_text}
        \target mcp-editor_get_text
    \li Returns the text of the current text editor as the user sees it, including unsaved changes. Optionally restrict to a line range via \c {start_line}/\c {end_line} (1-based, inclusive). Also works for editors without a file path, such as diff views or other temporary editors, which \l {mcp-fs_read_text}{fs_read_text} cannot read; "path" is empty for those and \c {display_name} names the editor. Unlike \l {mcp-editor_select_text}{editor_select_text} this leaves the cursor and selection alone. Read-only.
        \list
            \li \c {end_line} (integer) - Last line to return, 1-based inclusive (optional).
            \li \c {start_line} (integer) - First line to return, 1-based inclusive (optional).
        \endlist
\row
    \li \c {editor_list_open}
        \target mcp-editor_list_open
    \li Lists currently open files.
\row
    \li \c {editor_list_visible}
        \target mcp-editor_list_visible
    \li Lists all files that are currently visible to the user in an editor.
\row
    \li \c {editor_move_cursor}
        \target mcp-editor_move_cursor
    \li Warps the real mouse pointer to a root coordinate with \c {QCursor::setPos}, so a screen recording shows the cursor. By default it glides over a few steps. Pass steps=1 to jump. This only moves the pointer - it does not click.
        \list
            \li \c {steps} (integer) - Interpolation steps for the glide (default 20).
            \li \c {x} (integer, required)
            \li \c {y} (integer, required)
        \endlist
\row
    \li \c {editor_open}
        \target mcp-editor_open
    \li Opens a file in Qt Creator, optionally jumping to a specific line and column.
        \list
            \li \c {column} (integer) - 1-based column number to jump to (optional, requires line).
            \li \c {line} (integer) - 1-based line number to jump to (optional).
            \li \c {path} (string, required) - Absolute path of the file to open.
        \endlist
\row
    \li \c {editor_reformat}
        \target mcp-editor_reformat
    \li Reformats a specified file using Qt Creator's code formatting rules. Opens the file if not already open.
        \list
            \li \c {path} (string, required) - Absolute path to the file to reformat.
        \endlist
\row
    \li \c {editor_save}
        \target mcp-editor_save
    \li Saves a file in Qt Creator.
        \list
            \li \c {path} (string, required) - Absolute path of the file to save.
        \endlist
\row
    \li \c {editor_select_text}
        \target mcp-editor_select_text
    \li Selects text in the current text editor, from \c {start_line}/\c {start_column} to \c {end_line}/\c {end_column} (1-based, the columns default to the start of the first and the end of the last line). Sets up the selection that behavior like printing a selection, commenting or an external tool replacing the selection depends on - typing cannot produce it, and the incremental find highlights matches without moving the cursor. Returns the selected text.
        \list
            \li \c {end_column} (integer) - 1-based column, defaults to the end of the line.
            \li \c {end_line} (integer, required) - 1-based line the selection ends on.
            \li \c {start_column} (integer) - 1-based column, defaults to 1.
            \li \c {start_line} (integer, required) - 1-based line the selection starts on.
        \endlist
\row
    \li \c {fakevim_send_keys}
        \target mcp-fakevim_send_keys
    \li Funnels a string of keystrokes into the \c {FakeVim} handler of the current editor, exactly as if typed in Vim. The string uses Vim key notation: printable characters stand for themselves and special keys are angle-bracket escapes, so "ihello<Esc>" inserts "hello" and returns to normal mode, "3j" moves down three lines, "dd" deletes a line and "<C-v>" is Ctrl-V. \c {FakeVim} must be enabled (Edit > Preferences > \c {FakeVim}, or the Use \c {FakeVim} action). Returns the 1-based cursor line and column after the keys were processed, so a scenario can assert the effect of a motion or edit.
        \list
            \li \c {keys} (string, required) - Keystrokes in Vim notation, such as "ihello<Esc>" or "3j".
        \endlist
\row
    \li \c {fs_apply_patch}
        \target mcp-fs_apply_patch
    \li Applies a unified diff to files on disk using the configured patch command. Give the diff in "patch". "strip" is the number of leading path components to drop from each file in the diff (like patch -p): use 1 for git-style diffs with a/ and b/ prefixes (the default), 0 for diffs with plain paths. Paths are resolved against \c {working_directory}, which defaults to the startup project's directory. Set "revert" to true to undo the diff instead. On failure nothing is left half-applied only if the patch command rejects atomically. Check "output" for the tool's own messages (including rejected hunks).
        \list
            \li \c {patch} (string, required) - The unified diff to apply.
            \li \c {revert} (boolean) - Revert the diff instead of applying it.
            \li \c {strip} (integer) - Leading path components to strip (patch -p). Default 1.
            \li \c {working_directory} (string) - Directory the diff paths are relative to. Defaults to the startup project's directory.
        \endlist
\row
    \li \c {fs_get_info}
        \target mcp-fs_get_info
    \li Returns metadata for a path using \c {Utils::FilePath}: existence, type, size, modification time, executable bit and permissions. Local and remote paths are both supported through Qt Creator URL-like paths such as \c {ssh://user@host/path} or \c {docker://id/path}. Remote access is transparent.
        \list
            \li \c {path} (string, required) - Path to inspect (local or remote URL-like path).
        \endlist
\row
    \li \c {fs_list_directory}
        \target mcp-fs_list_directory
    \li Lists directory entries using \c {Utils::FilePath}, with name, path, type, size, modification time and executable bit. Optionally filter by glob name patterns and recurse. Local and remote directories are both supported through Qt Creator URL-like paths such as \c {ssh://user@host/path} or \c {docker://id/path}. Remote access is transparent.
        \list
            \li \c {name_filters} (array) - Glob patterns to match, such as ['*.txt'] (optional).
            \li \c {path} (string, required) - Path of the directory (local or remote URL-like path).
            \li \c {recursive} (boolean) - Recurse into subdirectories (optional).
        \endlist
\row
    \li \c {fs_make_directory}
        \target mcp-fs_make_directory
    \li Creates a directory and any missing parents with \c {Utils::FilePath::ensureWritableDir}(). Local and remote paths are both supported through Qt Creator URL-like paths such as \c {ssh://user@host/path} or \c {docker://id/path}.
        \list
            \li \c {path} (string, required) - Path of the directory to create (local or remote URL-like path).
        \endlist
\row
    \li \c {fs_read_bytes}
        \target mcp-fs_read_bytes
    \li Reads raw file contents and returns them base64-encoded - use this for binary files. For text use \l {mcp-fs_read_text}{fs_read_text}. Optionally restrict to a byte range with offset/length. Local and remote files are both supported through Qt Creator URL-like paths such as \c {ssh://user@host/path} or \c {docker://id/path}. Remote access is transparent. \c {reason} distinguishes an empty directory from one that could not be read: \c {device_unavailable}, \c {not_found}, \c {not_a_directory}.
        \list
            \li \c {length} (integer) - Maximum number of bytes to read (optional).
            \li \c {offset} (integer) - Byte offset to start reading from (optional).
            \li \c {path} (string, required) - Path of the file (local or remote URL-like path).
        \endlist
\row
    \li \c {fs_read_text}
        \target mcp-fs_read_text
    \li Returns the content of the file as plain text. Optionally restrict to a line range with \c {start_line}/\c {end_line} (1-based, inclusive). For binary content use \l {mcp-fs_read_bytes}{fs_read_bytes} instead. Local and remote files are both supported through Qt Creator URL-like paths such as \c {ssh://user@host/path} or \c {docker://id/path}. Remote access is transparent.
        \list
            \li \c {end_line} (integer) - Last line to return, 1-based inclusive (optional).
            \li \c {path} (string, required) - Path of the file. May be a local path or a remote URL-like path (\c {ssh://user@host/path}, \c {docker://id/path}).
            \li \c {start_line} (integer) - First line to return, 1-based inclusive (optional).
        \endlist
\row
    \li \c {fs_remove}
        \target mcp-fs_remove
    \li Removes a file, or a directory when \c {recursive} is true, with \c {Utils::FilePath::removeFile}() / \c {removeRecursively}(). Local and remote paths are both supported through Qt Creator URL-like paths such as \c {ssh://user@host/path} or \c {docker://id/path}.
        \list
            \li \c {path} (string, required) - Path to remove (local or remote URL-like path).
            \li \c {recursive} (boolean) - Remove directories and their contents (optional).
        \endlist
\row
    \li \c {fs_replace_in_directory}
        \target mcp-fs_replace_in_directory
    \li Replaces all matches of a text pattern recursively in all files within a directory with replacement text.
        \list
            \li \c {case_sensitive} (boolean) - Whether the search should be case sensitive.
            \li \c {directory} (string, required) - Absolute path of the directory to search in.
            \li \c {pattern} (string, required) - Text pattern to search for.
            \li \c {regex} (boolean) - Whether the pattern is a regular expression.
            \li \c {replacement} (string, required) - Replacement text.
        \endlist
\row
    \li \c {fs_replace_in_file}
        \target mcp-fs_replace_in_file
    \li Replaces all matches of a text pattern in a single file with replacement text.
        \list
            \li \c {case_sensitive} (boolean) - Whether the search should be case sensitive.
            \li \c {path} (string, required) - Absolute path of the file to modify.
            \li \c {pattern} (string, required) - Text pattern to search for.
            \li \c {regex} (boolean) - Whether the pattern is a regular expression.
            \li \c {replacement} (string, required) - Replacement text.
        \endlist
\row
    \li \c {fs_replace_in_projects}
        \target mcp-fs_replace_in_projects
    \li Replaces all matches of a text pattern in files matching a file pattern within a project (or all projects) with replacement text.
        \list
            \li \c {case_sensitive} (boolean) - Whether the search should be case sensitive.
            \li \c {file_pattern} (string, required) - File pattern to filter which files to modify (such as '*.cpp', '*.h').
            \li \c {pattern} (string, required) - Text pattern to search for.
            \li \c {project_name} (string) - Optional: name of the project to search in (searches all projects if not specified).
            \li \c {regex} (boolean) - Whether the pattern is a regular expression.
            \li \c {replacement} (string, required) - Replacement text.
        \endlist
\row
    \li \c {fs_write_bytes}
        \target mcp-fs_write_bytes
    \li Writes base64-decoded raw bytes to a file, creating or overwriting it - use this for binary files. For text use \l {mcp-fs_write_text}{fs_write_text}. This writes directly to disk and does not route through the editor. Local and remote files are both supported through Qt Creator URL-like paths such as \c {ssh://user@host/path} or \c {docker://id/path}.
        \list
            \li \c {base64} (string, required) - Raw bytes to write, base64-encoded.
            \li \c {path} (string, required) - Path of the file (local or remote URL-like path).
        \endlist
\row
    \li \c {fs_write_text}
        \target mcp-fs_write_text
    \li Overwrites the file's text content with the provided string. Behavior depends on whether the file is currently open in a Qt Creator editor: - Not open: writes directly to disk. - Open with an unchanged buffer: updates the editor's in-memory buffer (visible to the user immediately). The change is not persisted to disk until \l {mcp-editor_save}{editor_save} is called. - Open with unsaved changes: refused with reason \c {file_open_with_unsaved_changes} to avoid silently overwriting the user's edits. Caller should ask the user to save (or call \l {mcp-editor_save}{editor_save}) and retry. For binary content use \l {mcp-fs_write_bytes}{fs_write_bytes} instead. Also supports files on remote devices with URIs like docker://... or ssh:// and others.
        \list
            \li \c {path} (string, required) - Absolute path of the file.
            \li \c {plain_text} (string, required) - Text to write into the file.
        \endlist
\row
    \li \c {get_application_output}
        \target mcp-get_application_output
    \li Returns recent log output captured from Qt Creator's \c {qDebug}()/\c {qCInfo}()/\c {qCWarning}()/... stream, including Q_LOGGING_CATEGORY output, as well as messages written to the General Messages pane (under the \c {general} category). Read incrementally by passing the \c {cursor} returned by the previous call as \c {sinceCursor}. Optionally filter by a logging-category prefix, such as \c {qtc.remotewindows} or \c {general}.
        \list
            \li \c {category} (string) - Only return lines whose logging category starts with this prefix (optional).
            \li \c {maxLines} (integer) - Maximum number of lines to return (most recent within the range). Defaults to 200.
            \li \c {sinceCursor} (integer) - Return only lines newer than this cursor. Use the \c {cursor} from a previous response. Omit or 0 to read from the start of the buffer.
        \endlist
\row
    \li \c {get_help_contents}
        \target mcp-get_help_contents
    \li Returns the top-level nodes of the Help Contents tree (as shown in the Help mode sidebar), built for the active filter. Reports \c {duplicate_titles} - titles that appear on more than one top-level node, which happens when several versions of a component are registered without a narrowing filter. "truncated" says nodes were left out because \c {max_nodes} ran out, \c {timed_out} that the wait for the tree to be built was given up on.
        \list
            \li \c {max_depth} (integer) - Tree depth to return (default 1, top level only, at most 10).
            \li \c {max_nodes} (integer) - Maximum number of nodes to return (default 2000, at most 20000).
        \endlist
\row
    \li \c {get_registered_documentation}
        \target mcp-get_registered_documentation
    \li Returns the namespaces of all documentation registered in the Help system. Several registered Qt versions produce several namespaces that differ only by their version suffix (for example "org.qt-project.qtcore.680").
\row
    \li \c {git_blame}
        \target mcp-git_blame
    \li Returns line-by-line authorship (git blame) for a file: for each line, the commit hash, author and commit subject. Give the "file" and optionally a \c {start_line}/\c {end_line} range (1-based) to limit the output. \c {start_line} alone blames from there to the end, \c {end_line} alone from the beginning. An \c {end_line} past the end of the file makes git fail, so omit it to blame to the end. At most "limit" lines are returned. \c {total_lines} and "truncated" report what was left out.
        \list
            \li \c {end_line} (integer) - Optional: last 1-based line to blame.
            \li \c {file} (string, required) - Absolute path to the file to blame.
            \li \c {limit} (integer) - Maximum number of lines to return (default 2000).
            \li \c {start_line} (integer) - Optional: first 1-based line to blame.
        \endlist
\row
    \li \c {git_diff}
        \target mcp-git_diff
    \li Returns the unified diff of uncommitted changes in the repository that contains a path. Give any file or directory inside the repository as "path". Set "staged" to diff the index against HEAD, or restrict the diff to one "file". The diff is cut at the last full line that fits into "limit" characters. \c {total_characters} and "truncated" report what was left out.
        \list
            \li \c {file} (string) - Optional: restrict the diff to this file.
            \li \c {limit} (integer) - Maximum number of characters of diff to return (default 100000).
            \li \c {path} (string, required) - Absolute path to a file or directory inside the repository.
            \li \c {staged} (boolean) - Diff staged changes (index vs HEAD) instead of the working tree (default false).
        \endlist
\row
    \li \c {git_log}
        \target mcp-git_log
    \li Returns recent Git commits for the repository that contains a path, most recent first, each with its hash, author, date and subject. Give any file or directory inside the repository as "path". Optionally cap the count with \c {max_count} and restrict history to one "file".
        \list
            \li \c {file} (string) - Optional: restrict the log to this file's history.
            \li \c {max_count} (integer) - Maximum number of commits (default 20).
            \li \c {path} (string, required) - Absolute path to a file or directory inside the repository.
        \endlist
\row
    \li \c {git_status}
        \target mcp-git_status
    \li Returns the Git working-tree status of the repository that contains a path: the current branch and the list of changed files, each with its two-character porcelain status code. Renames and copies also report the \c {original_path}. On a detached HEAD "branch" is empty and "detached" is true. Give any file or directory inside the repository as "path".
        \list
            \li \c {path} (string, required) - Absolute path to a file or directory inside the repository.
        \endlist
\row
    \li \c {kit_add_to_project}
        \target mcp-kit_add_to_project
    \li Adds a build target for each of the given kits to a project. Kits may be identified by kit ID or display name (see \l {mcp-kit_list}{kit_list}). Defaults to the active startup project when neither \c {project_name} nor \c {project_path} is given. Returns a per-kit results array with status added/\c {already_present}/\c {not_found}/failed. The call does not abort on the first error. When multiple loaded projects share the same display name, pass \c {project_path} to disambiguate.
        \list
            \li \c {kits} (array, required) - Kit IDs or display names to add to the project.
            \li \c {project_name} (string) - Display name of the project. Optional. Defaults to the active startup project.
            \li \c {project_path} (string) - Absolute path to the project file. Unambiguously identifies the project and takes precedence over \c {project_name}.
        \endlist
\row
    \li \c {kit_get_aspect_options}
        \target mcp-kit_get_aspect_options
    \li Lists the values a kit aspect can be set to (for item-backed aspects such as the debugger, toolchain, Qt version or device). Each option has a value (to pass to \l {mcp-kit_set_value}{kit_set_value}) and a display name. An empty list means the aspect is free-form.
        \list
            \li \c {aspect_id} (string, required) - Aspect ID (from \l {mcp-kit_get_aspects}{kit_get_aspects}).
            \li \c {kit_id} (string, required)
        \endlist
\row
    \li \c {kit_get_aspects}
        \target mcp-kit_get_aspects
    \li Lists the configurable aspects of a kit (debugger, toolchains, Qt version, device, ...). Each entry has the aspect ID, its display name, a human-readable current value, and the raw stored value. Use the aspect ID with \l {mcp-kit_get_aspect_options}{kit_get_aspect_options} and \l {mcp-kit_set_value}{kit_set_value}.
        \list
            \li \c {kit_id} (string, required) - Kit ID (as reported by \l {mcp-kit_list}{kit_list}).
        \endlist
\row
    \li \c {kit_list}
        \target mcp-kit_list
    \li Lists all kits configured in Qt Creator. Each entry includes the kit name, its ID, whether it is valid, whether it has warnings, whether it is the default kit, whether it was auto-detected (and SDK-provided), a filesystem-friendly name, the kit's run and build device, and an issues array with validation messages for invalid or warning kits.
\row
    \li \c {kit_list_for_project}
        \target mcp-kit_list_for_project
    \li Lists the kits a project is configured for (one per build target). Defaults to the active startup project when neither \c {project_name} nor \c {project_path} is given. Each kit entry has the same fields as \l {mcp-kit_list}{kit_list} plus \c {is_active}, which marks the kit of the project's active target. When multiple loaded projects share the same display name, pass \c {project_path} to disambiguate (returns reason:\c {ambiguous_name} with candidates otherwise).
        \list
            \li \c {project_name} (string) - Display name of the project. Optional. Defaults to the active startup project.
            \li \c {project_path} (string) - Absolute path to the project file. Unambiguously identifies the project and takes precedence over \c {project_name}.
        \endlist
\row
    \li \c {kit_remove}
        \target mcp-kit_remove
    \li Removes kits from Qt Creator, identified by kit ID or display name (see \l {mcp-kit_list}{kit_list}). Use it to clean up after \l {mcp-device_detect_tools}{device_detect_tools}, which creates a kit per toolchain found on a device. \l {mcp-kit_list}{kit_list} reports each kit's run and build device, so the kits belonging to a device can be picked out. Returns a per-kit results array with status removed/\c {not_found}/\c {sdk_provided}/\c {ambiguous_name}. The call does not abort on the first error. SDK-provided kits cannot be removed. Removing a kit drops the corresponding build target from every project using it, so its build and run settings are lost.
        \list
            \li \c {kits} (array, required) - Kit IDs or display names to remove.
        \endlist
\row
    \li \c {kit_rename}
        \target mcp-kit_rename
    \li Gives a kit another display name, as editing it on the Kits preferences page does. Worth knowing why it matters: the default build directory of a project is derived from the kit name, so two kits that share one name also share one build directory and overwrite each other's configuration. Kits generated per Qt version collide that way when the versions carry the same version number and ABI. The kit may be given by ID or display name (see \l {mcp-kit_list}{kit_list}). A name several kits share has to be told apart by ID, which is the case this is for.
        \list
            \li \c {kit} (string, required) - Kit ID or current display name.
            \li \c {name} (string, required) - The new display name.
        \endlist
\row
    \li \c {kit_set_active}
        \target mcp-kit_set_active
    \li Makes the project build and run with one of the kits it is configured for, as choosing it in the kit selector does. The kit may be given by ID or display name (see \l {mcp-kit_list}{kit_list}, and \l {mcp-kit_list_for_project}{kit_list_for_project} for which are configured and which is active). A display name that several kits share is refused, so use the ID to tell them apart. Defaults to the active startup project when neither \c {project_name} nor \c {project_path} is given.
        \list
            \li \c {kit} (string, required) - Kit ID or display name to make active.
            \li \c {project_name} (string) - Display name of the project. Optional. Defaults to the active startup project.
            \li \c {project_path} (string) - Absolute path to the project file. Unambiguously identifies the project and takes precedence over \c {project_name}.
        \endlist
\row
    \li \c {kit_set_value}
        \target mcp-kit_set_value
    \li Sets a kit aspect to a value. Pass the value reported by \l {mcp-kit_get_aspect_options}{kit_get_aspect_options} for item-backed aspects (the exact stored type is preserved). Free-form aspects take the value as-is. Aspects holding a list, such as the CMake configuration, take an array of strings.
        \list
            \li \c {aspect_id} (string, required)
            \li \c {kit_id} (string, required)
            \li \c {value} (required) - Value to set.
        \endlist
\row
    \li \c {list_help_filters}
        \target mcp-list_help_filters
    \li Returns the documentation filters known to the Help system, the available component versions, and the currently active filter. Selecting a filter narrows the Contents tree to matching documentation.
\row
    \li \c {lsp_call_hierarchy}
        \target mcp-lsp_call_hierarchy
    \li Returns the callers ("incoming") or the callees ("outgoing") of the function at a position, as the language server (clangd for C++, or whatever server is configured for the file type) computes them from its index. Give the file and a 1-based line and column on a function name. Each entry has the function's name, kind, file and position, the \c {from_ranges} where the calls happen, and, with a "depth" above 1, its own "calls" nested below it. clangd supports outgoing calls from version 20.1 on and reports an error before that. The file is opened in a hidden editor if it is not open. A server that is still starting asks to be retried.
        \list
            \li \c {column} (integer, required) - 1-based column of the function name.
            \li \c {depth} (integer) - How many levels to follow, 1 to 3 (default 1).
            \li \c {direction} (string) - "incoming" for the callers (default), "outgoing" for the callees.
            \li \c {file} (string, required) - Absolute path to the source file.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
            \li \c {line} (integer, required) - 1-based line of the function name.
        \endlist
\row
    \li \c {lsp_definition}
        \target mcp-lsp_definition
    \li Returns where the symbol at a position is defined, as the language server (clangd for C++, qmlls for QML, or whatever server is configured for the file type) resolves it - templates, overloads and macros included. Give the file and a 1-based line and column on an identifier. "kind" chooses the question: "definition" (default) for the symbol's own definition, or its declaration when the server knows no definition. \c {type_definition} for the definition of the symbol's type, for a variable or parameter. "implementation" for the overrides of a virtual function or the classes implementing an interface. Each location has its file and 1-based line/column to \c {end_line}/\c {end_column}. The file is opened in a hidden editor if it is not open. A server that is still starting asks to be retried.
        \list
            \li \c {column} (integer, required) - 1-based column of the identifier.
            \li \c {file} (string, required) - Absolute path to the source file.
            \li \c {kind} (string) - What to go to (default "definition").
            \li \c {line} (integer, required) - 1-based line of the identifier.
        \endlist
\row
    \li \c {lsp_hover}
        \target mcp-lsp_hover
    \li Returns what the language server shows on hover at a position: the declaration, its type, and its documentation comment, as markdown or plain text, plus the range the information applies to. Answers come from clangd for C++, qmlls for QML, or whatever server is configured for the file type, so this is the tool for a symbol's documentation. Give the file and a 1-based line and column on an identifier. The file is opened in a hidden editor if it is not open. A server must be configured for its file type, and a server that is still starting asks to be retried.
        \list
            \li \c {column} (integer, required) - 1-based column of the identifier.
            \li \c {file} (string, required) - Absolute path to the source file.
            \li \c {line} (integer, required) - 1-based line of the identifier.
        \endlist
\row
    \li \c {lsp_references}
        \target mcp-lsp_references
    \li Finds every reference to the symbol at a position, as the language server (clangd for C++, qmlls for QML, or whatever server is configured for the file type) knows them from its index - templates, overloads and macros included, across all files it has indexed. Give the file and a 1-based line and column on an identifier. Each reference has its file and 1-based line/column to \c {end_line}/\c {end_column}. The declaration is included unless \c {include_declaration} is false. The list is sorted by file and position and capped by "limit", with "total" and "truncated" saying what was left out. The file is opened in a hidden editor if it is not open. A server that is still starting asks to be retried.
        \list
            \li \c {column} (integer, required) - 1-based column of the identifier.
            \li \c {file} (string, required) - Absolute path to the source file.
            \li \c {include_declaration} (boolean) - Also list the symbol's declaration(s). Default true.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
            \li \c {line} (integer, required) - 1-based line of the identifier.
        \endlist
\row
    \li \c {lsp_rename}
        \target mcp-lsp_rename
    \li Renames the symbol at a position everywhere the language server (clangd for C++, qmlls for QML, or whatever server is configured for the file type) knows it - templates, overloads and macros included. Give the file, a 1-based line and column on the identifier, and the \c {new_name}. By default this is a dry run: it returns the edits the server proposes (each with file, 1-based position, old and new text) and changes nothing. Set "apply" to true to make the edits: they reach the files on disk, and a file open in an editor is updated there too, unless it had unsaved changes of its own, in which case it is edited but not saved and named in \c {unsaved_files}. The server refuses a name that clashes within the same scope. Other symbols that already carry the new name anywhere in the project are listed as "conflicts" for you to judge, and do not block. The file is opened in a hidden editor if it is not open. A server that is still starting asks to be retried.
        \list
            \li \c {apply} (boolean) - Make the edits. Default false (dry run).
            \li \c {column} (integer, required) - 1-based column of the identifier to rename.
            \li \c {file} (string, required) - Absolute path to the source file.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
            \li \c {line} (integer, required) - 1-based line of the identifier to rename.
            \li \c {new_name} (string, required) - The new identifier name.
        \endlist
\row
    \li \c {lsp_symbols}
        \target mcp-lsp_symbols
    \li Searches the language server's index for symbols by name - the way to turn a name into the file and position the other lsp_ tools take. Give a "query" (matched fuzzily, ranked by the server) and any "file" the server handles, which picks the server: a C++ file for clangd, a QML file for qmlls. Each symbol has its name, kind, container (class or namespace), file and 1-based line/column of its name. "limit" caps the count. "truncated" says whether more matched. The file is opened in a hidden editor if it is not open. A server that is still starting asks to be retried.
        \list
            \li \c {file} (string, required) - Absolute path to a file the server handles. Chooses the server.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
            \li \c {query} (string, required) - The symbol name to search for.
        \endlist
\row
    \li \c {lsp_type_hierarchy}
        \target mcp-lsp_type_hierarchy
    \li Returns the base classes ("supertypes"), the derived classes ("subtypes") or both of the class at a position, as the language server (clangd for C++, or whatever server is configured for the file type) computes them from its index. Give the file and a 1-based line and column on a class name. Each entry has the type's name, kind, file and position, and, with a "depth" above 1, its own "supertypes" or "subtypes" nested below it. The file is opened in a hidden editor if it is not open. A server that is still starting asks to be retried.
        \list
            \li \c {column} (integer, required) - 1-based column of the class name.
            \li \c {depth} (integer) - How many levels to follow, 1 to 3 (default 1).
            \li \c {direction} (string) - "supertypes" for the bases, "subtypes" for the derived classes, "both" (default) for both.
            \li \c {file} (string, required) - Absolute path to the source file.
            \li \c {limit} (integer) - Maximum number of results (default 200, capped at 1000).
            \li \c {line} (integer, required) - 1-based line of the class name.
        \endlist
\row
    \li \c {plugin_list}
        \target mcp-plugin_list
    \li Lists all installed plugins together with their current run state and whether they can be loaded at runtime without a restart.
\row
    \li \c {plugin_load}
        \target mcp-plugin_load
    \li Soft-loads a plugin, and its soft-loadable dependencies, into the running Qt Creator without a restart. Only works for plugins marked as soft-loadable. There is no matching unload.
        \list
            \li \c {name} (string, required) - Name of the plugin to load, as reported by \l {mcp-plugin_list}{plugin_list}.
        \endlist
\row
    \li \c {plugin_save_settings}
        \target mcp-plugin_save_settings
    \li Writes the current enabled/disabled state of all plugins to disk so it survives a restart. Use after \l {mcp-plugin_load}{plugin_load} to make a runtime-loaded plugin load again on the next start.
\row
    \li \c {process_run}
        \target mcp-process_run
    \li Executes the command and returns the exit code as well as standard output and error.
        \list
            \li \c {arguments} (string) - Arguments passed to the command.
            \li \c {command} (string, required) - Command to execute.
            \li \c {working_dir} (string) - Directory in which the command is executed.
        \endlist
\row
    \li \c {profiler_perf_get_status}
        \target mcp-profiler_perf_get_status
    \li Returns whether the perf profiler is recording, whether a perf run is active, and a summary of the data collected so far: the sample/event count and the trace duration in nanoseconds.
\row
    \li \c {profiler_perf_start}
        \target mcp-profiler_perf_start
    \li Starts the CPU (perf) profiler on the current startup project (perf profiler run mode), using its active run configuration and kit. Does not build first - use the \l {mcp-build_project}{build_project} tool beforehand if it may be out of date. Recording starts automatically. Poll \l {mcp-profiler_perf_get_status}{profiler_perf_get_status}, and use \l {mcp-profiler_perf_stop}{profiler_perf_stop} (or let the application exit) to finalize the trace. Returns as soon as the run is requested, unlike \l {mcp-run_project}{run_project} with \c {run_mode} \c {PerfProfiler}.\c {RunMode}, which waits for the run to finish and gives no access to the trace.
\row
    \li \c {profiler_perf_stop}
        \target mcp-profiler_perf_stop
    \li Stops the running perf profiler session by requesting its run control to stop, which finalizes the trace. Returns an error if no perf session is running. Poll \l {mcp-profiler_perf_get_status}{profiler_perf_get_status} afterwards for the finalized sample count.
\row
    \li \c {profiler_qml_get_status}
        \target mcp-profiler_qml_get_status
    \li Returns the QML profiler state (Idle/\c {AppRunning}/\c {AppStopRequested}/\c {AppDying}, or Unavailable if the profiler is gone), whether the server is recording, whether a profiler run is active, and a summary of the data collected so far: the event count and the trace duration in nanoseconds.
\row
    \li \c {profiler_qml_start}
        \target mcp-profiler_qml_start
    \li Starts the QML profiler on the current startup project (QML profiler run mode), using its active run configuration and kit. Does not build first - use the \l {mcp-build_project}{build_project} tool beforehand if it may be out of date. Recording starts automatically. Poll \l {mcp-profiler_qml_get_status}{profiler_qml_get_status} for progress, and use \l {mcp-profiler_qml_stop}{profiler_qml_stop} (or let the application exit) to finalize the trace. Returns as soon as the run is requested, unlike \l {mcp-run_project}{run_project}, which waits for the run to finish.
\row
    \li \c {profiler_qml_stop}
        \target mcp-profiler_qml_stop
    \li Stops the running QML profiler session by requesting its run control to stop, which finalizes the trace. Returns an error if no profiler session is running. Poll \l {mcp-profiler_qml_get_status}{profiler_qml_get_status} afterwards for the finalized event count.
\row
    \li \c {project_find_files}
        \target mcp-project_find_files
    \li Finds all files matching the pattern in a given project.
        \list
            \li \c {pattern} (string, required) - Pattern for finding the file, either a glob pattern or a regex.
            \li \c {project_name} (string) - Name of the project to limit the search to (optional).
            \li \c {regex} (boolean) - Whether the pattern is a regex (default is false).
        \endlist
\row
    \li \c {project_get_current}
        \target mcp-project_get_current
    \li Gets the currently active project.
\row
    \li \c {project_get_dependencies}
        \target mcp-project_get_dependencies
    \li Lists project dependencies for all projects.
        \list
            \li \c {name} (string, required) - Name of the project to query dependencies for.
        \endlist
\row
    \li \c {project_get_modules}
        \target mcp-project_get_modules
    \li Describes a project's structure: its runnable application targets (name, build key, executable, and defining project file) and the other loaded projects it depends on (from the session Dependencies settings). Selects the project by \c {project_name} or \c {project_path}, defaulting to the startup project. "targets" comes from the build system's application targets, so it lists executables and runnable utility targets only - libraries and other non-runnable targets are not reported - and it is empty until the project is configured with a kit and parsed.
        \list
            \li \c {project_name} (string) - Name of the project. Defaults to the startup project.
            \li \c {project_path} (string) - Project file path, to disambiguate a shared name.
        \endlist
\row
    \li \c {project_list}
        \target mcp-project_list
    \li Lists all loaded projects. Each entry includes the project name, its file path, the active version control branch, and whether it is the current startup project (\c {is_active}). Use path or branch to disambiguate when multiple projects share the same display name (common in multi-worktree setups).
\row
    \li \c {project_list_repositories}
        \target mcp-project_list_repositories
    \li Lists all known version control repositories (such as Git and Subversion) that are within the directories of all open projects.
        \list
            \li \c {name} (string, required) - Name of the project to query repositories for.
        \endlist
\row
    \li \c {project_open}
        \target mcp-project_open
    \li Opens a project in Qt Creator from a project file path (such as \c {CMakeLists.txt}, a .pro, .qbs, or .qmlproject file). If the project is already open, returns success with \c {already_open}=true. The opened project is added to the session. Use \l {mcp-project_set_active}{project_set_active} to make it the startup project.
        \list
            \li \c {path} (string, required) - Absolute path to the project file to open (such as \c {CMakeLists.txt}, .pro, .qbs, .qmlproject).
        \endlist
\row
    \li \c {project_set_active}
        \target mcp-project_set_active
    \li Changes the active startup project (the one Qt Creator builds, runs, and debugs by default). Accepts \c {project_name}, \c {project_path}, or both. When multiple loaded projects share the same display name (for example, the same project open in two Git worktrees), you must also supply \c {project_path} to disambiguate. The tool returns reason:\c {ambiguous_name} with a candidates array if \c {project_path} is omitted and the name matches more than one project.
        \list
            \li \c {project_name} (string) - Display name of the project to activate. Required unless \c {project_path} alone is sufficient to identify it.
            \li \c {project_path} (string) - Absolute path to the project file. Unambiguously identifies the project and takes precedence over \c {project_name} when multiple projects share the same display name.
        \endlist
\row
    \li \c {project_show_panel}
        \target mcp-project_show_panel
    \li Switches to Projects mode and shows one of the active project's settings panels. Pass panel = "build", "deploy" or "run" for the target's Build/Deploy/Run Settings tabs, or a project-panel ID (such as "Editor") for the left-hand project settings. Use this to reach settings only shown in these panels, such as the run configuration's "Executable on device" field. Returns an error when no project is open.
        \list
            \li \c {panel} (string, required) - "build", "deploy" or "run" for the target settings tabs, or a project-panel ID for the left-hand project settings.
        \endlist
\row
    \li \c {qt_add_version}
        \target mcp-qt_add_version
    \li Registers the Qt version a qmake belongs to, as "Add..." on the Qt Versions preferences page does. Returns what the version turned out to be, so that a caller can tell which platform it was recognized as. A qmake that is already registered is returned as it stands.
        \list
            \li \c {name} (string) - Display name for the version. Defaults to the name the detection came up with.
            \li \c {qmake_path} (string, required) - Path to the qmake executable of the Qt to add.
        \endlist
\row
    \li \c {qt_get_directory}
        \target mcp-qt_get_directory
    \li Returns the Qt installation paths for the Qt version used by the active kit of the current project. Includes the installation prefix, version string, bin, header, and library paths.
        \list
            \li \c {project_name} (string) - Name of the project to query. Defaults to the active startup project.
        \endlist
\row
    \li \c {qt_remove_version}
        \target mcp-qt_remove_version
    \li Removes a registered Qt version, as "Remove" on the Qt Versions preferences page does. The version is given by its ID or by its qmake path. Auto-detected versions cannot be removed.
        \list
            \li \c {id} (integer) - Unique ID of the version, as \l {mcp-qt_add_version}{qt_add_version} returns it.
            \li \c {qmake_path} (string) - Path to the qmake executable of the version.
        \endlist
\row
    \li \c {register_documentation}
        \target mcp-register_documentation
    \li Registers the given .qch documentation files with the Help system and waits for the registration to finish. Returns the resulting namespaces. Registering several versions of the same component is how duplicate top-level nodes appear in the Contents tree. \c {timed_out} tells a caller that the wait was given up on, so the namespaces are whatever was registered at that point rather than the finished result.
        \list
            \li \c {paths} (array, required) - Absolute paths to .qch documentation files.
        \endlist
\row
    \li \c {run_configure}
        \target mcp-run_configure
    \li Selects an existing run configuration (by display name or type ID, see \l {mcp-run_list_configs}{run_list_configs}) as the active one and/or sets its executable, the arguments the application is started with, and its working directory. Setting the executable only works for run configurations that have one, such as the bare-metal "Custom Executable" configuration. Then \l {mcp-debugger_start}{debugger_start} (with no arguments) debugs it with its run configuration's own launch path. Several run configurations share one type ID, so an ID matching more than one fails with reason "ambiguous" and the matching display names in "candidates", rather than picking one of them.
        \list
            \li \c {arguments} (string) - Command-line arguments to start the application with, as one string. An empty one clears them.
            \li \c {executable} (string) - Executable to set on the run configuration (local path).
            \li \c {id} (string, required) - Run configuration display name, or type ID when it is unique.
            \li \c {set_active} (boolean) - Make this the active run configuration.
            \li \c {working_directory} (string) - Directory to start the application in. An empty one restores the run configuration's default.
        \endlist
\row
    \li \c {run_list_configs}
        \target mcp-run_list_configs
    \li Returns the project's existing run configurations. Each entry includes the display name, the run configuration type ID, whether it is the active one, and the resolved runnable: executable, arguments, working directory, and the full run environment (key-value map, as the application would see it).
\row
    \li \c {run_list_modes}
        \target mcp-run_list_modes
    \li Lists every run mode that has a registered run worker, and whether the current startup project can be run in each one right now (with the reason if not). Use a runnable ID as \l {mcp-run_project}{run_project}'s \c {run_mode}. Interactive modes have dedicated tools (\l {mcp-debugger_start}{debugger_start}, \l {mcp-profiler_qml_start}{profiler_qml_start}).
\row
    \li \c {run_project}
        \target mcp-run_project
    \li Runs the current startup project and waits for it to finish. Progress messages from the application are streamed during execution. On success, returns the full output plus the run outcome: \c {exitCode} (absent if the process crashed or the terminal launch failed) and succeeded (exit code 0). On build failure, returns \c {isError}=true with structured content in the same shape as the Issues pane's tasks (issues array + summary). By default this is a normal run. Pass \c {run_mode} to run the project under a different, non-interactive run mode such as an analyzer (the run must finish on its own). Interactive modes have dedicated tools: use \l {mcp-debugger_start}{debugger_start} for debugging and \l {mcp-profiler_qml_start}{profiler_qml_start} for the QML profiler. Returns an error if there is no startup project, no active build configuration, or the project cannot currently be run in the requested mode.
        \list
            \li \c {run_mode} (string) - Run-mode ID to run the startup project under. Defaults to the normal run mode (\c {RunConfiguration}.\c {NormalRunMode}). Examples: \c {PerfProfiler}.\c {RunMode}, \c {RunConfiguration}.\c {QmlProfilerRunMode}. The mode must have a run worker registered for the project's device and run to completion. Interactive modes belong to \l {mcp-debugger_start}{debugger_start} / \l {mcp-profiler_qml_start}{profiler_qml_start}.
        \endlist
\row
    \li \c {search_directory}
        \target mcp-search_directory
    \li Searches for a text pattern recursively in all files within a directory and returns all matches.
        \list
            \li \c {case_sensitive} (boolean) - Whether the search should be case sensitive.
            \li \c {directory} (string, required) - Absolute path of the directory to search in.
            \li \c {pattern} (string, required) - Text pattern to search for.
            \li \c {regex} (boolean) - Whether the pattern is a regular expression.
        \endlist
\row
    \li \c {search_file}
        \target mcp-search_file
    \li Searches for a text pattern in a single file and returns all matches with line, column, and matched text.
        \list
            \li \c {case_sensitive} (boolean) - Whether the search should be case sensitive.
            \li \c {path} (string, required) - Absolute path of the file to search.
            \li \c {pattern} (string, required) - Text pattern to search for.
            \li \c {regex} (boolean) - Whether the pattern is a regular expression.
        \endlist
\row
    \li \c {search_projects}
        \target mcp-search_projects
    \li Searches for a text pattern in files matching a file pattern within a project (or all projects) and returns all matches.
        \list
            \li \c {case_sensitive} (boolean) - Whether the search should be case sensitive.
            \li \c {file_pattern} (string, required) - File pattern to filter which files to search (such as '*.cpp', '*.h').
            \li \c {max_results} (number) - How many matches to return (default 200). Clamped to 1-5000. \c {total_matches} reports how many there were.
            \li \c {pattern} (string, required) - Text pattern to search for.
            \li \c {project_name} (string) - Optional: name of the project to search in (searches all projects if not specified).
            \li \c {regex} (boolean) - Whether the pattern is a regular expression.
        \endlist
\row
    \li \c {session_get_current}
        \target mcp-session_get_current
    \li Gets the currently active session.
\row
    \li \c {session_list}
        \target mcp-session_list
    \li Lists available sessions.
\row
    \li \c {session_load}
        \target mcp-session_load
    \li Loads a specific session.
        \list
            \li \c {session_name} (string, required) - Name of the session to load.
        \endlist
\row
    \li \c {session_save}
        \target mcp-session_save
    \li Saves the current session.
\row
    \li \c {set_help_filter}
        \target mcp-set_help_filter
    \li Sets the active documentation filter by name. Pass an empty name to clear the filter (show all documentation).
        \list
            \li \c {filter} (string) - Filter name, or empty for no filter.
        \endlist
\row
    \li \c {set_help_version_filter}
        \target mcp-set_help_version_filter
    \li Creates (if needed) and activates a documentation filter that shows only the given component version, for example "6.12.0". Pass an empty version to clear the filter. Use this to collapse duplicate top-level nodes that come from several registered versions. The filter this tool created is removed again when the filter is cleared or another version replaces it, so the user's Help configuration is left as it was.
        \list
            \li \c {version} (string) - Version like "6.12.0", or empty to clear.
        \endlist
\row
    \li \c {set_logging_rules}
        \target mcp-set_logging_rules
    \li Applies \c {QLoggingCategory} filter rules at runtime, equivalent to QT_LOGGING_RULES, such as \c {qtc.remotewindows.*=true}. Separate multiple rules with newlines. Use this to enable a logging category before reading it back with \l {mcp-get_application_output}{get_application_output}.
        \list
            \li \c {rules} (string, required) - Logging rules, one per line, such as \c {qtc.*.debug=true}.
        \endlist
\row
    \li \c {settings_get}
        \target mcp-settings_get
    \li Returns the individual settings (aspects) of a preference page: key, label, current value and default value. Use the page ID from \l {mcp-settings_list_pages}{settings_list_pages}. Read-only.
        \list
            \li \c {page} (string, required) - Settings page ID (see \l {mcp-settings_list_pages}{settings_list_pages}).
        \endlist
\row
    \li \c {settings_list_pages}
        \target mcp-settings_list_pages
    \li Lists Qt Creator preference pages whose settings are exposed as aspects, so they can be read with \l {mcp-settings_get}{settings_get} and changed with \l {mcp-settings_set}{settings_set}. Pages with hand-rolled widgets (no aspect container) are omitted. Read-only.
\row
    \li \c {settings_set}
        \target mcp-settings_set
    \li Sets a single aspect-based setting to a new value and persists it. The change takes effect immediately (the aspect emits its change signal), so this is the programmatic equivalent of toggling the setting in the Preferences dialog. Identify the setting by its \c {key} (\c {settingsKey} from \l {mcp-settings_get}{settings_get}). The value is coerced to the setting's current type.
        \list
            \li \c {key} (string, required) - \c {settingsKey} of the setting (see \l {mcp-settings_get}{settings_get}).
            \li \c {page} (string, required) - Settings page ID.
            \li \c {value} (required) - New value (bool/number/string), coerced to the setting's type.
        \endlist
\row
    \li \c {settings_show_page}
        \target mcp-settings_show_page
    \li Opens Preferences on the given page, so that its widgets can be driven with \l {mcp-ui_find_widgets}{ui_find_widgets}, \l {mcp-ui_click_widget}{ui_click_widget} and the item tools. Pages build their widgets lazily, so a page that has never been shown has none to find. Give the page id from \l {mcp-settings_list_pages}{settings_list_pages}, or none to open Preferences where it last was.
        \list
            \li \c {page_id} (string) - Page ID, such as "Alien.Settings" (optional).
        \endlist
\row
    \li \c {setup_android}
        \target mcp-setup_android
    \li Runs Android auto-configuration - the same action as applying the Android SDK preferences page - which registers the NDK toolchains and (re)creates the automatic Android kits from the configured SDK/NDK and the installed Qt-for-Android versions. Use after the Android SDK location and a Qt-for-Android version are configured to obtain a usable Android kit without driving the preferences GUI. Returns all kits present afterwards, each with the ID of its run device type, so that the Android ones can be told apart, plus the Android Qt versions and Android toolchains that the kit creation had to work with. Fails if the configured Android SDK is not usable, which is otherwise indistinguishable from having no NDK and no Qt-for-Android version.
\row
    \li \c {test_get_details}
        \target mcp-test_get_details
    \li Returns per-test details for the named tests from the most recent run. By default returns only the small, actionable fields - status, \c {failure} (the extracted assertion for a failing test), \c {warnings} (any warning lines), file/line, duration - so a build/test/fix loop never has to wade through a huge log. Names typically come from \l {mcp-test_run}{test_run} / \l {mcp-test_get_last_results}{test_get_last_results} (`failures` / `\c {tests_with_warnings}`). Unmatched names appear in `\c {not_found}`. Pass include:["log"] for the full (tail-capped) output as `message`, and include:["messages"] for the \c {qDebug}/\c {qInfo}/... context array. `truncated` is set when any text was capped. The full log is always in Qt Creator's Test Results pane.
        \list
            \li \c {include} (array) - Optional heavy fields beyond the default status/failure/warnings: "log" adds the full (capped) output as \c {message}. "messages" adds the context array. Omit to keep the response small.
            \li \c {names} (array, required) - Test names to fetch details for.
        \endlist
\row
    \li \c {test_get_last_results}
        \target mcp-test_get_last_results
    \li Returns a read-only summary of the most recent test run. Reflects whatever was last executed - by \l {mcp-test_run}{test_run} or by the user clicking Run/Debug in the Tests pane. Returns counts plus name lists for failures and tests-with-warnings. Use \l {mcp-test_get_details}{test_get_details} with specific test names to see per-test messages, file/line, and full debug log. Calling \l {mcp-test_run}{test_run} instead would re-execute and potentially erase a flaky or debug-only failure.
\row
    \li \c {test_get_status}
        \target mcp-test_get_status
    \li Reports whether a test run is currently in progress and whether the snapshot holds results worth looking at. Call this before \l {mcp-test_run}{test_run} if there is any chance the user has just produced an interesting result (for example, a debug-mode failure) in the Tests pane that you do not want to overwrite.
\row
    \li \c {test_list}
        \target mcp-test_list
    \li Enumerates every test class Autotest currently knows about, with its functions. Useful as a discovery step before calling \l {mcp-test_run}{test_run} - gives exact class and function names to pass as \l {mcp-test_run}{test_run}({scope: "named", names: [\c {Class::function}]}) without guessing from build artifacts. Each entry carries the framework label (such as "Qt Test", "Google Test"). Returns empty if Autotest has not finished parsing yet or the project has no recognized tests.
\row
    \li \c {test_run}
        \target mcp-test_run
    \li Builds (if needed) and runs autotests, then returns a compact summary: counts, list of failed/fatal/skipped test names, and list of passing test names that emitted warnings. Runs the whole suite unless you pass scope=\c {named} with names - prefer that when you already know which tests you care about. A full run can be slow enough to hit a client timeout. Equivalent to clicking Run (or Debug, with mode=\c {debug}) in the Tests pane. Returns once the run finishes. To see per-test details (messages, file/line, and so on), follow up with \l {mcp-test_get_details}{test_get_details} using any test name from the run - failures, warnings, or just a passing test you want to inspect. \l {mcp-test_get_details}{test_get_details} returns the full message log for every named test regardless of its outcome. An empty messages[] means the test did not emit anything. Note: each call replaces the current snapshot - if the user has just run something interesting in the UI, call \l {mcp-test_get_last_results}{test_get_last_results} first instead of clobbering it. Read `finished` first. When it is true the summary is this run's result. When it is false nothing failed - the run has not ended yet, and the response carries a \c {run_id}, \c {elapsed_ms} and a reason of \c {still_running}, or \c {joined_existing_run} if the run it is waiting for is one that was already going. Call \l {mcp-test_run}{test_run} again with that \c {run_id} to keep waiting, and repeat until finished is true. Do not start a second run and do not sleep between calls: each call does the waiting for you. A run already going - whether this tool started it or the user hit Run in the Tests pane - is joined rather than refused, so a repeated call cannot launch a competing run.
        \list
            \li \c {mode} (string) - How to execute. \c {run} is the normal mode. \c {debug} runs them under the debugger, which can reproduce timing-sensitive failures that do not manifest in plain Run mode (for example, \c {qFatals} that only fire when stepped through). Debug mode is much slower. Use it for narrowing in on a known failure.
            \li \c {names} (array) - Test names to run. Requires scope=\c {named}. Passing names with any other scope is an error. Use \c {Class}, or \c {Class::function} for frameworks that list functions - CTest entries have none, so only the whole test runs. Names typically come from `failures` or `\c {tests_with_warnings}` in a previous summary, or from \l {mcp-test_list}{test_list}. Names must already be present in Autotest's current model - if a name is not found, call \l {mcp-cmake_reconfigure}{cmake_reconfigure} first to trigger a re-parse (needed after adding or renaming test functions).
            \li \c {run_id} (integer) - Attach to the run with this ID instead of starting one. Use the \c {run_id} from a previous \c {still_running} response.
            \li \c {scope} (string) - Which tests to run. \c {all} runs every discovered test (default). \c {selected} means whatever the user has ticked in the Tests pane, not a selection the caller passes, so it is rarely what a caller wants. \c {failed} re-runs the tests that failed in the previous run. \c {named} runs only the tests in the `names` array. Set this to run one test, as `names` with any other scope is rejected.
            \li \c {wait_ms} (integer) - How long to block before returning reason:\c {still_running}, in milliseconds (default 45000). Clamped to 1000-55000: a longer wait outlives the request timeout of typical clients, which drops the session and cancels the run. Poll with \c {run_id} instead of asking for a longer wait.
        \endlist
\row
    \li \c {ui_activate_menu_item}
        \target mcp-ui_activate_menu_item
    \li Finds a menu bar entry or an item in a currently-open menu by visible text and activates it through the menu API. Shows a submenu (\c {QMenu::popup}) so a scenario can navigate into it, and triggers a leaf item. The trigger is posted asynchronously, so this does not block even when it opens a modal dialog. Pair with \l {mcp-ui_find_menu_item}{ui_find_menu_item} and \l {mcp-editor_move_cursor}{editor_move_cursor} to drive a menu with the cursor.
        \list
            \li \c {title} (string, required) - Visible text of the menu or item.
        \endlist
\row
    \li \c {ui_activate_mode}
        \target mcp-ui_activate_mode
    \li Switches Qt Creator to a top-level mode (the left mode bar) and returns the current mode ID. Omit "mode" to just query. A mode only activates when it is available (for example, "Project" needs an open project). Common IDs: "Welcome", "Edit", "Design", "Project" (the Projects/build-run-settings mode), "Mode.Debug", "Help".
        \list
            \li \c {mode} (string) - Mode ID to activate (optional, omit to just query).
        \endlist
\row
    \li \c {ui_answer_message_box}
        \target mcp-ui_answer_message_box
    \li Clicks a button on the currently-open message box - the active modal one, or the most recently shown box still visible - to dismiss it. The button is matched by its text with the mnemonic '&' and case ignored, or by the untranslated standard-button name, so "Yes", "No", "Ok", "Cancel" work whatever the UI language. See \l {mcp-ui_get_message_boxes}{ui_get_message_boxes} for the available buttons. Returns an error (with \c {available_buttons}) if there is no open box or no match.
        \list
            \li \c {button} (string, required) - Text of the button to click (mnemonic '&' and case ignored).
        \endlist
\row
    \li \c {ui_call_action}
        \target mcp-ui_call_action
    \li Calls an action by its ID.
        \list
            \li \c {id} (string) - ID of the action to call.
        \endlist
\row
    \li \c {ui_click_item}
        \target mcp-ui_click_item
    \li Clicks one item of the item view matching the widget query, by delivering a left click at its center, so the view reacts exactly as it would to the user - selection, activation and any command the item carries. Name the item by its full path ("Outgoing / Fix the thing") or, when unambiguous, by its label. Zero or multiple matches are an error.
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {context_menu} (boolean) - Ask the row for its context menu instead of clicking it. The menu is then driven with \l {mcp-ui_activate_menu_item}{ui_activate_menu_item}.
            \li \c {double_click} (boolean) - Double-click the row. Some views act only on that (opening what the row stands for), and a single click then does nothing.
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {item} (string, required) - Full path or label of the item to click.
            \li \c {modifiers} (string) - Keyboard modifiers held while clicking, "+"-separated out of "ctrl", "shift", "alt" and "meta". This is how a multi-selection is built: ctrl adds the row to the selection, shift extends it to the row.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\row
    \li \c {ui_click_tab}
        \target mcp-ui_click_tab
    \li Clicks one tab of the \c {QTabBar} matching the widget query, by the text on it. A tab is not a widget of its own, so it cannot be reached with \l {mcp-ui_click_widget}{ui_click_widget}.
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {tab} (string, required) - Text on the tab, matched after trimming and stripping '&'.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\row
    \li \c {ui_click_widget}
        \target mcp-ui_click_widget
    \li Clicks the single widget matching the query with a synthetic left press and release, the events a real click produces - a widget is free to act on the mouse itself, and some do. The click lands on the widget's center, except on a check box or radio button, where only the indicator reacts to one. The query must resolve to exactly one visible widget - zero or multiple matches are an error, so the tool never silently picks a widget. The result describes the widget as \l {mcp-ui_find_widgets}{ui_find_widgets} does, so a toggle can be told from a miss.
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\row
    \li \c {ui_find_actions}
        \target mcp-ui_find_actions
    \li Finds actions matching a query string.
        \list
            \li \c {query} (string) - String to search for in action names.
        \endlist
\row
    \li \c {ui_find_items}
        \target mcp-ui_find_items
    \li Lists the items of the single item view matching the widget query - a tree, list or table - with the path of labels leading to each row, its text, whether it has children, is expanded, selected or enabled, and its geometry in root coordinates. This is the addressing layer for \l {mcp-ui_click_item}{ui_click_item} and \l {mcp-ui_set_item_expanded}{ui_set_item_expanded}, and the way to assert what a view actually shows. A view that fills lazily only has the children of rows that were expanded, so expand first and look again.
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {item} (string) - Only report items whose full path or label is exactly this.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\row
    \li \c {ui_find_menu_item}
        \target mcp-ui_find_menu_item
    \li Returns the geometry, in root coordinates, of a menu bar entry (such as "Help") or of an item in a currently-open menu (such as "About Qt Creator"), matched by visible text ('&' and a trailing ... are ignored). Menu items are QActions, not addressable widgets, so this is how a scenario drives menus with the cursor. Read-only.
        \list
            \li \c {title} (string, required) - Visible text of the menu or item.
        \endlist
\row
    \li \c {ui_find_widgets}
        \target mcp-ui_find_widgets
    \li Resolves a semantic widget query against the live Qt Creator UI by walking all widgets (including dialogs and popups). Returns every match with its class, \c {objectName}, visible text - an excerpt for a long one, with \c {text_truncated} set - enabled/visible state, checked state where the widget has one - with the three-way \c {check_state} for a tristate check box, whose "checked" is true for the partial state too - geometry in root coordinates and top-level window ID. This is the addressing layer for \l {mcp-ui_click_widget}{ui_click_widget} / \l {mcp-ui_type_text}{ui_type_text} / \l {mcp-ui_select_combo_item}{ui_select_combo_item}: use it to discover selectors and to check that a query is unambiguous before acting on it. Read-only.
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\row
    \li \c {ui_get_message_boxes}
        \target mcp-ui_get_message_boxes
    \li Returns the \c {QMessageBox} popups (warnings, errors, questions, ...) shown since startup, including transient or non-modal ones that never reach the log or message panes. Each entry has the title, text, \c {informative_text}, icon, buttons, modality, and openness. Pass \c {open_only}=true to get only the currently-visible ones.
        \list
            \li \c {open_only} (boolean) - Only return message boxes that are still open.
        \endlist
\row
    \li \c {ui_get_pointer_position}
        \target mcp-ui_get_pointer_position
    \li Returns the pointer position in screen coordinates, which is what a screen recording shows. Useful to check that a paced click actually moved it.
\row
    \li \c {ui_list_windows}
        \target mcp-ui_list_windows
    \li Lists the top-level windows of the running Qt Creator - the main window and any open dialogs or popups - each with its class, \c {objectName}, title, geometry, window ID, and whether it is active or modal. Use it to see which dialog is up before addressing widgets inside it. Read-only.
        \list
            \li \c {include_invisible} (boolean) - Also list hidden windows (default false).
        \endlist
\row
    \li \c {ui_mouse_event}
        \target mcp-ui_mouse_event
    \li Delivers one mouse press, move or release to the widget matching the query at widget-local coordinates (x, y). Because the three actions are separate calls, a caller can press, do something else, then move and release - for example, hold a drag on a \c {QMainWindow} dock separator across a relayout. \c {describeWidget} in the result gives the widget's screen geometry to compute coordinates from.
        \list
            \li \c {action} (string, required) - Which mouse action to send.
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
            \li \c {x} (integer, required) - Widget-local x.
            \li \c {y} (integer, required) - Widget-local y.
        \endlist
\row
    \li \c {ui_press_keys}
        \target mcp-ui_press_keys
    \li Sends a key chord parsed with \c {QKeySequence} (such as "Ctrl+K", "Escape", "Return", "Ctrl+Shift+P", "Down") to the focused widget, or to the single widget matching the query. Use it for keys a widget handles directly (Return, Escape, Tab, arrows) and to demonstrate a shortcut being pressed. To reliably trigger an action's effect regardless of focus, prefer \l {mcp-ui_call_action}{ui_call_action} - a synthetic key event does not always drive application-wide shortcuts.
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {keys} (string, required) - Key sequence, such as "Ctrl+K" or "Escape".
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\row
    \li \c {ui_read_general_messages}
        \target mcp-ui_read_general_messages
    \li Returns the recent General Messages pane text - the warnings, errors and status that plugins surface to the user outside the Compile Output and Application Output panes. Use it to see diagnostics that are otherwise only shown in the GUI.
\row
    \li \c {ui_read_output_pane}
        \target mcp-ui_read_output_pane
    \li Returns the plain text of an output pane (such as "Application Output", "General Messages", "Compile Output"), identified by its display name. This is the text the user sees in the pane, distinct from \l {mcp-get_application_output}{get_application_output} which returns Qt Creator's own log stream. Call without a name (or with an unknown one) to get the list of available panes. Panes that are not plain-text (such as Issues) report \c {pane_has_no_text_output}. Read-only.
        \list
            \li \c {max_lines} (integer) - Return only the last N lines (optional).
            \li \c {name} (string) - Display name of the pane (see \c {available_panes}).
        \endlist
\row
    \li \c {ui_read_widget_text}
        \target mcp-ui_read_widget_text
    \li Returns up to \c {max_chars} characters of the text of the widget the query resolves to, where \l {mcp-ui_find_widgets}{ui_find_widgets} answers with a 400 character excerpt. "length" is the size of the whole text. Meant for a log view or another document whose end is the interesting part: set "tail" to read the last characters rather than the first. Read-only.
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {max_chars} (integer) - At most this many characters, 20000 by default.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {tail} (boolean) - Read the last \c {max_chars} characters instead of the first.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\row
    \li \c {ui_screenshot}
        \target mcp-ui_screenshot
    \li Captures a window and returns it as a PNG. If widget query fields are given, the target's top-level window is captured (for example, \c {window_title} of a dialog). Otherwise the active window, falling back to the main window. Rendering is done in-process with \c {QWidget::grab}(), so the image is deterministic and never blank - no compositor or retry needed, unlike an external screen grab. Pass \c {path} to also save the PNG to disk. The base64 is embedded in the result only when no path is given (or embed=true).
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {embed} (boolean) - Embed base64 PNG in the result (default: true unless a path is given).
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {path} (string) - Optional file path to save the PNG to.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\row
    \li \c {ui_select_combo_item}
        \target mcp-ui_select_combo_item
    \li Selects an item by its text in the single \c {QComboBox} matching the query, as a user picking it would: the index is set and activated() is emitted, which many combo boxes act on rather than \c {currentIndexChanged}. This avoids the pitfall that pressing Return on a focused combo box opens its dropdown instead of choosing. The query must resolve to exactly one \c {QComboBox}.
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {item} (string, required) - Exact text of the item to select.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\row
    \li \c {ui_set_demo_pace}
        \target mcp-ui_set_demo_pace
    \li Slows the widget tools down so a screen capture of a driven session looks like someone using the IDE: the pointer travels to what \l {mcp-ui_click_widget}{ui_click_widget} clicks at a set speed, buttons show as held down, and \l {mcp-ui_type_text}{ui_type_text} arrives character by character. All delays are in milliseconds. Zero everywhere (the default) restores the immediate behavior that tests want.
        \list
            \li \c {click_hold_ms} (integer) - How long a click is held, for example, 120.
            \li \c {key_delay_ms} (integer) - Pause after each typed character, for example, 60.
            \li \c {pointer_speed} (integer) - How fast the pointer travels to a target, in pixels per second, for example, 700, so that the time it takes follows the distance. Zero leaves the pointer alone.
        \endlist
\row
    \li \c {ui_set_item_expanded}
        \target mcp-ui_set_item_expanded
    \li Expands or collapses one item of the \c {QTreeView} matching the widget query. Needed to reach nested items at all: a view that fills lazily asks its source for the children only when a row is expanded, so the children appear in \l {mcp-ui_find_items}{ui_find_items} a moment later, not immediately.
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {expanded} (boolean) - Expand it (default), or collapse it when false.
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {item} (string, required) - Full path or label of the item.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\row
    \li \c {ui_show_caption}
        \target mcp-ui_show_caption
    \li Puts a line of text over the main window for a while, and returns once it is gone. For a screen recording of a driven session: a step with no visible trigger, a mode being switched or a run being started from a tool, otherwise just happens. An empty text removes the caption right away.
        \list
            \li \c {seconds} (number) - How long it stays, 2 by default.
            \li \c {text} (string, required) - What the caption says.
        \endlist
\row
    \li \c {ui_type_text}
        \target mcp-ui_type_text
    \li Types text by delivering key events, so widgets that react to typing (line edits, text editors) update as if the user typed. If widget query fields are given they select and focus the target (which must resolve to exactly one widget). Otherwise the current focus widget receives the input. It types text: a special key has no notation here, so a "\\n" in the input is a newline character rather than a Return press - use \c {press_keys} for a key sequence, or \l {mcp-fakevim_send_keys}{fakevim_send_keys} for Vim notation such as ":w<CR>".
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {input} (string, required) - The text to type. Typed as characters - see the tool description for how to send a key instead.
            \li \c {mode} (string) - "append" (the default) types at the cursor and keeps what is already there. "set" replaces the content, so the widget ends up holding exactly the input - use it for a filter or a line edit that a previous call left non-empty. An empty input then clears it. Only text inputs accept it.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\row
    \li \c {ui_widget_exists}
        \target mcp-ui_widget_exists
    \li Reports whether the widget query matches any live widget, and how many. Use it as an assertion (for example, "the preview opened") without failing on zero matches the way \l {mcp-ui_click_widget}{ui_click_widget} does. Read-only.
        \list
            \li \c {class_name} (string) - Meta-object class name, such as \c {QPushButton}. Matches the exact class or any subclass (\c {QAbstractButton} matches \c {QPushButton}).
            \li \c {include_invisible} (boolean) - Also match hidden widgets (default false).
            \li \c {index} (integer) - Pick the nth match, 0-based and in on-screen order (top to bottom, then left to right), instead of failing when the query matches several widgets. Listing tools report just that match.
            \li \c {object_name} (string) - Exact \c {objectName}(). The most robust selector: stable across translation and layout changes.
            \li \c {text} (string) - Visible text (button/label/combo/groupbox), or, for an input like a line edit, its buddy label's text. Matched exactly after trimming and stripping '&' accelerators. Readable but translation-sensitive.
            \li \c {window_title} (string) - Restrict to widgets whose top-level window title contains this (case-insensitive), for example, to disambiguate an OK button by its dialog.
        \endlist
\endtable
//! [tools]
