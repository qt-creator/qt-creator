[submodule "qbs"]
	path = src/shared/qbs
	url = ../../qbs/qbs.git
	ignore = dirty
[submodule "src/libs/qlitehtml"]
	path = src/libs/qlitehtml
	url = https://code.qt.io/playground/qlitehtml.git
[submodule "googletest"]
	path = src/libs/3rdparty/googletest
	url = https://github.com/google/googletest.git
[submodule "whisper.cpp"]
	path = src/libs/3rdparty/whisper.cpp
	url = https://github.com/ggml-org/whisper.cpp.git
	shallow = true
