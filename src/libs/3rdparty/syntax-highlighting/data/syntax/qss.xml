    <contexts>
      <!-- Selectors -->
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>
        <IncludeRules context="FindComments"/>
        <RegExpr lookAhead="true" String="(&qproperty;|-?[a-z][-a-z0-9]*)\s*:(?!:)[^{}]*;" context="Declarations"/>
        <DetectChar char="{" attribute="Block Symbol" context="RuleSet" beginRegion="ruleset"/>
        <DetectChar char="}" attribute="Error"/>
        <Detect2Chars char=":" char1=":" attribute="Sub-Control" context="SubControl"/>
        <DetectChar char=":" attribute="Pseudo-State" context="PseudoState"/>
        <DetectChar char="[" attribute="Selector Symbol" context="PropertySelector"/>
        <RegExpr String="#[-_a-zA-Z0-9]+" attribute="Selector Id"/>
        <RegExpr String="\.&ident;" attribute="Selector Class"/>
        <AnyChar String="*&gt;+~," attribute="Selector Symbol"/>
        <RegExpr String="&ident;" attribute="Selector Type"/>
      </context>

      <context name="SubControl" attribute="Unknown Sub-Control" lineEndContext="#pop" fallthroughContext="#pop">
        <keyword String="sub-controls" attribute="Sub-Control" context="#pop"/>
        <RegExpr String="&ident;" attribute="Unknown Sub-Control" context="#pop"/>
      </context>

      <context name="PseudoState" attribute="Unknown Pseudo-State" lineEndContext="#pop" fallthroughContext="#pop">
        <DetectChar char="!" attribute="Selector Symbol"/>
        <keyword String="pseudo-states" attribute="Pseudo-State" context="#pop"/>
        <RegExpr String="&ident;" attribute="Unknown Pseudo-State" context="#pop"/>
      </context>

      <context name="PropertySelector" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>
        <DetectChar char="]" attribute="Selector Symbol" context="#pop"/>
        <Detect2Chars char="~" char1="=" attribute="Selector Symbol"/>
        <Detect2Chars char="|" char1="=" attribute="Selector Symbol"/>
        <DetectChar char="=" attribute="Selector Symbol"/>
        <DetectChar char="&quot;" attribute="String" context="StringDQ"/>
        <DetectChar char="'" attribute="String" context="StringSQ"/>
        <RegExpr String="[_a-zA-Z][_a-zA-Z0-9]*" attribute="Selector Property"/>
        <AnyChar String="{}" lookAhead="true" context="#pop"/>
      </context>

      <!-- Declarations -->
      <context name="RuleSet" attribute="Normal Text" lineEndContext="#stay">
        <DetectChar char="}" attribute="Block Symbol" context="#pop" endRegion="ruleset"/>
        <IncludeRules context="FindDeclarations"/>
      </context>

      <context name="Declarations" attribute="Normal Text" lineEndContext="#pop">
        <IncludeRules context="FindDeclarations"/>
      </context>

      <context name="FindDeclarations" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>
        <IncludeRules context="FindComments"/>
        <DetectChar char=";" attribute="Separator Symbol"/>
        <RegExpr String="&qproperty;" attribute="Qt Property" context="PropertySeparator"/>
        <keyword String="properties" attribute="Property" context="PropertySeparator"/>
        <RegExpr String="&ident;" attribute="Unknown Property" context="PropertySeparator"/>
        <DetectChar char="{" attribute="Error"/>
      </context>

      <context name="PropertySeparator" attribute="Normal Text" lineEndContext="#stay" fallthroughContext="#pop">
        <DetectSpaces/>
        <DetectChar char=":" attribute="Property Separator" context="#pop!Value"/>
      </context>

      <!-- Values -->
      <context name="Value" attribute="Normal Text" lineEndContext="#stay">
        <DetectChar char=";" attribute="Separator Symbol" context="#pop"/>
        <DetectChar char="}" lookAhead="true" context="#pop"/>
        <IncludeRules context="FindValues"/>
      </context>

      <context name="FindValues" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>
        <IncludeRules context="FindComments"/>
        <DetectChar char="&quot;" attribute="String" context="StringDQ"/>
        <DetectChar char="'" attribute="String" context="StringSQ"/>
        <RegExpr String="#([0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3})(?![-_a-zA-Z0-9])" attribute="Color"/>
        <RegExpr String="#[-_a-zA-Z0-9]*" attribute="Error"/>
        <RegExpr String="q(linear|radial|conical)gradient(?=\s*\()" insensitive="true" attribute="Function" context="GradientOpen"/>
        <RegExpr String="url(?=\s*\()" insensitive="true" attribute="Function" context="UrlOpen"/>
        <RegExpr String="(rgba?|hsva?|hsla?|palette)(?=\s*\()" insensitive="true" attribute="Function" context="ArgumentsOpen"/>
        <RegExpr String="&ident;(?=\s*\()" attribute="Unknown Function" context="ArgumentsOpen"/>
        <RegExpr String="[-+]?([0-9]+(\.[0-9]*)?|\.[0-9]+)" attribute="Number" context="Unit"/>
        <keyword String="value keywords" attribute="Value Keyword"/>
        <keyword String="colors" attribute="Named Color"/>
        <keyword String="palette roles" attribute="Value Keyword"/>
        <RegExpr String="&ident;" attribute="Normal Text"/>
        <AnyChar String=",/" attribute="Operator"/>
      </context>

      <context name="Unit" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="#pop">
        <RegExpr String="(px|pt|em|ex)(?![-_a-zA-Z0-9])" insensitive="true" attribute="Unit" context="#pop"/>
        <DetectChar char="%" attribute="Unit" context="#pop"/>
      </context>

      <context name="GradientOpen" attribute="Normal Text" lineEndContext="#stay" fallthroughContext="#pop">
        <DetectSpaces/>
        <DetectChar char="(" attribute="Operator" context="#pop!GradientArguments"/>
      </context>

      <context name="GradientArguments" attribute="Normal Text" lineEndContext="#stay">
        <keyword String="gradient parameters" attribute="Function Parameter"/>
        <keyword String="gradient spreads" attribute="Value Keyword"/>
        <DetectChar char=":" attribute="Operator"/>
        <IncludeRules context="Arguments"/>
      </context>

      <context name="ArgumentsOpen" attribute="Normal Text" lineEndContext="#stay" fallthroughContext="#pop">
        <DetectSpaces/>
        <DetectChar char="(" attribute="Operator" context="#pop!Arguments"/>
      </context>

      <context name="Arguments" attribute="Normal Text" lineEndContext="#stay">
        <DetectChar char=")" attribute="Operator" context="#pop"/>
        <AnyChar String=";}" lookAhead="true" context="#pop"/>
        <IncludeRules context="FindValues"/>
      </context>

      <context name="UrlOpen" attribute="Normal Text" lineEndContext="#stay" fallthroughContext="#pop">
        <DetectSpaces/>
        <DetectChar char="(" attribute="Operator" context="#pop!Url"/>
      </context>

      <context name="Url" attribute="Url" lineEndContext="#pop">
        <DetectSpaces attribute="Normal Text"/>
        <DetectChar char=")" attribute="Operator" context="#pop"/>
        <DetectChar char="&quot;" attribute="String" context="StringDQ"/>
        <DetectChar char="'" attribute="String" context="StringSQ"/>
        <AnyChar String=";}" lookAhead="true" context="#pop"/>
        <RegExpr String="[^\s)&quot;';}]+" attribute="Url"/>
      </context>

      <!-- Strings and comments -->
      <context name="StringDQ" attribute="String" lineEndContext="#pop">
        <RegExpr String="\\." attribute="SpecialChar"/>
        <DetectChar char="&quot;" attribute="String" context="#pop"/>
      </context>

      <context name="StringSQ" attribute="String" lineEndContext="#pop">
        <RegExpr String="\\." attribute="SpecialChar"/>
        <DetectChar char="'" attribute="String" context="#pop"/>
      </context>

      <context name="FindComments" attribute="Normal Text" lineEndContext="#stay">
        <Detect2Chars char="/" char1="*" attribute="Comment" context="Comment" beginRegion="comment"/>
      </context>

      <context name="Comment" attribute="Comment" lineEndContext="#stay">
        <DetectSpaces/>
        <Detect2Chars char="*" char1="/" attribute="Comment" context="#pop" endRegion="comment"/>
        <IncludeRules context="##Comments"/>
        <DetectIdentifier/>
      </context>
    </contexts>

