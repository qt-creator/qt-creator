{
    "Id" : "profiler",
    "DisplayName" : "Profiler",
    "Name" : "Profiler",
    "Version" : "${IDE_VERSION}",
    "CompatVersion" : "${IDE_VERSION_COMPAT}",
    "VendorId" : "theqtcompany",
    "Vendor" : "The Qt Company Ltd",
    "Copyright" : "${IDE_COPYRIGHT}",
    "License" : [ "Commercial Usage",
                  "",
                  "Licensees holding valid Qt Commercial licenses may use this plugin in accordance with the Qt Commercial License Agreement provided with the Software or, alternatively, in accordance with the terms contained in a written agreement between you and The Qt Company.",
                  "",
                  "GNU General Public License Usage",
                  "",
                  "Alternatively, this plugin may be used under the terms of the GNU General Public License version 3 as published by the Free Software Foundation with exceptions as appearing in the file LICENSE.GPL3-EXCEPT included in the packaging of this plugin. Please review the following information to ensure the GNU General Public License requirements will be met: https://www.gnu.org/licenses/gpl-3.0.html."
    ],
    "Category" : "Code Analyzer",
    "Description" : "Profile Qt Quick applications and analyze CPU and memory usage.",
    "LongDescription" : [
        "Find causes for typical performance problems, such as slowness and unresponsive, stuttering user interfaces.",
        "Analyze the CPU and memory usage of an application on embedded devices and, to a limited extent, on Linux desktop platforms.",
        "For perf-based analysis you also need:",
            "- Perf tool (bundled with the Linux kernel)"
    ],
    "Url" : "https://www.qt.io",
    "DocumentationUrl" : "https://doc.qt.io/qtcreator/creator-qml-performance-monitor.html",
    "Mimetypes" : [
        "<?xml version='1.0'?>",
        "<mime-info xmlns='http://www.freedesktop.org/standards/shared-mime-info'>",
        "    <mime-type type='application/x-qmlprofiler-trace'>",
        "        <comment>QML Profiler trace file</comment>",
        "        <glob pattern='*.qtd'/>",
        "        <glob pattern='*.qzt'/>",
        "    </mime-type>",
        "    <mime-type type='application/x-perfprofiler-trace'>",
        "        <comment>Perf Profiler trace file</comment>",
        "        <glob pattern='*.ptq'/>",
        "    </mime-type>",
        "    <mime-type type='application/x-chrome-trace'>",
        "        <sub-class-of type='application/json'/>",
        "        <comment>Chrome Trace Format file</comment>",
        "        <magic>",
        "            <match value='&quot;traceEvents&quot;' type='string' offset='0:16384'/>",
        "        </magic>",
        "        <!-- Same weight as application/json's, so the name alone stays",
        "             ambiguous and the magic above is what decides. Two things",
        "             come with that: every .json file now has its first 16 KB",
        "             read to be identified, and one that is no trace at all",
        "             matches no magic and falls back to the alphabetically",
        "             first candidate. Any type named here must therefore sort",
        "             after 'application/json', or every .json file in every",
        "             project becomes a trace. -->",
        "        <glob pattern='*.json' weight='50'/>",
        "    </mime-type>",
        "    <mime-type type='application/x-combined-profiler-trace'>",
        "        <sub-class-of type='application/json'/>",
        "        <comment>Combined profiler trace manifest</comment>",
        "        <magic>",
        "            <match value='&quot;qmlClockOffsetUs&quot;' type='string' offset='0:16384'/>",
        "        </magic>",
        "        <!-- Same weight as application/json's; see the note above for",
        "             what that costs and the naming it rests on. -->",
        "        <glob pattern='*.json' weight='50'/>",
        "    </mime-type>",
        "    <mime-type type='application/x-ctf-trace'>",
        "        <sub-class-of type='text/plain'/>",
        "        <comment>Common Trace Format metadata</comment>",
        "        <!-- CTF 2 metadata is a JSON text sequence: every record is preceded",
        "             by a record separator, and the first one is the preamble. Matching",
        "             the separator and the word rather than a spelling of the object",
        "             takes the pretty-printed form too. CTF 1.8 is either its packet",
        "             magic, in whichever byte order the trace was written, or plain",
        "             TSDL text, which carries no marker of its own beyond the header",
        "             comment the tools that emit it write. -->",
        "        <magic priority='70'>",
        "            <match value='0x1e' type='byte' offset='0'>",
        "                <match value='preamble' type='string' offset='0:512'/>",
        "            </match>",
        "            <match value='0x75d11d57' type='big32' offset='0'/>",
        "            <match value='0x75d11d57' type='little32' offset='0'/>",
        "            <match value='/* CTF 1.8 */' type='string' offset='0:64'/>",
        "        </magic>",
        "    </mime-type>",
        "    <mime-type type='application/x-sampler-trace'>",
        "        <sub-class-of type='application/x-ctf-trace'/>",
        "        <comment>Call-stack sampler trace metadata</comment>",
        "        <!-- The same, and the stream only a sampler recording declares.",
        "             Higher priority so it wins over the plain CTF2 rule. -->",
        "        <magic priority='80'>",
        "            <match value='0x1e' type='byte' offset='0'>",
        "                <match value='sampler-stacks' type='string' offset='0:16384'/>",
        "            </match>",
        "        </magic>",
        "    </mime-type>",
        "</mime-info>"
    ],
    ${IDE_PLUGIN_DEPENDENCIES}
}
