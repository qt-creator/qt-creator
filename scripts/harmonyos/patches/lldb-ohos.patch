@@ -0,0 +1,53 @@
+//===-- PlatformOHOS.cpp --------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "PlatformOHOS.h"
+
+#include "lldb/Core/PluginManager.h"
+#include "lldb/Utility/ArchSpec.h"
+
+using namespace lldb;
+using namespace lldb_private;
+using namespace lldb_private::platform_ohos;
+
+LLDB_PLUGIN_DEFINE(PlatformOHOS)
+
+static uint32_t g_initialize_count = 0;
+
+PlatformOHOS::PlatformOHOS() : platform_linux::PlatformLinux(false) {}
+
+PlatformSP PlatformOHOS::CreateInstance(bool force, const ArchSpec *arch) {
+  // OpenHarmony is Linux-flavoured, so the Linux platform would claim every
+  // matching triple. Hand out this one only when it was asked for by name.
+  if (!force)
+    return PlatformSP();
+  return PlatformSP(new PlatformOHOS());
+}
+
+llvm::StringRef PlatformOHOS::GetPluginDescriptionStatic() {
+  return "Remote OpenHarmony user platform plug-in.";
+}
+
+void PlatformOHOS::Initialize() {
+  platform_linux::PlatformLinux::Initialize();
+
+  if (g_initialize_count++ == 0) {
+    PluginManager::RegisterPlugin(GetPluginNameStatic(),
+                                  GetPluginDescriptionStatic(),
+                                  PlatformOHOS::CreateInstance, nullptr);
+  }
+}
+
+void PlatformOHOS::Terminate() {
+  if (g_initialize_count > 0) {
+    if (--g_initialize_count == 0)
+      PluginManager::UnregisterPlugin(PlatformOHOS::CreateInstance);
+  }
+
+  platform_linux::PlatformLinux::Terminate();
+}
