{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "include": [
    "mingw.json", "msvc.json"
  ],
  "configurePresets": [
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "graphviz" : "${sourceDir}/build-${presetName}/graphviz.dot",
      "toolchainFile" : "$env{HOME}/Qt/6.11.1/gcc_64/lib/cmake/Qt6/qt.toolchain.cmake",
      "condition" : {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "qt.io/QtCreator/1.0": {
          "runDevice": {
            "type": "GenericLinuxOsType",
            "id": "CMakePresetsManualTestDevice",
            "name": "cmakepresets-test-device",
            "host": "192.168.1.100",
            "uname": "pi",
            "keyFile": "$env{HOME}/.ssh/id_rsa",
            "sshPort": 22,
            "authentication": 1,
            "timeout": 7,
            "machineType": 1,
            "freePortsSpec": "8000-9000"
          },
          "runEnvironment": {
            "HOME_VARIABLE_WITH_HEART": "$env{HOME}/❤️"
          },
          "runSettings": [
            {
              "target": "cmakepresets",
              "useTerminal": true,
              "arguments": "--verbose",
              "workingDirectory": "${sourceDir}"
            }
          ]
        }
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS Clang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "graphviz" : "${sourceDir}/build-${presetName}/graphviz.dot",
      "condition" : {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "vendor": {
        "qt.io/QtCreator/1.0": {
          "runDevice": "GenericLinuxOsType",
          "runEnvironment": {
            "HOME_VARIABLE_WITH_HEART": "$env{HOME}/❤️"
          },
          "runSettings": [
            {
              "target": "cmakepresets",
              "useTerminal": true,
              "useDyldSuffix": true,
              "runAs": "root",
              "arguments": "--verbose",
              "workingDirectory": "${sourceDir}"
            },
            {
              "target": "cmakepresets",
              "displayName": "cmakepresets two",
              "useTerminal": false,
              "useDyldSuffix": false,
              "runAs": "cool",
              "arguments": "--verbose --two",
              "workingDirectory": "${sourceDir}"
            },
            {
              "target": "hello",
              "useTerminal": true
            },
            {
              "target": "bash",
              "useTerminal": true,
              "executable": "/bin/bash",
              "arguments": "--help",
              "active": true
            }
          ]
        }
      }
    }
  ]
}
